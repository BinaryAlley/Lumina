    + StartScanAsync(scan: LibraryScan, libraryType: LibraryType, downloadMetadataFromWeb: bool, token: CancellationToken): Task<ErrorOr<Success>>
    + CancelScan(scan: LibraryScan): ErrorOr<Success>
}

note top of MediaLibraryScanningService
  Central service that starts a scan by building its job graph,
  registering it in the cancellation and progress trackers and
  enqueueing the root jobs, and that cancels a running scan.
end note

' ============================== QUEUE AND PROCESSING ==============================

interface IMediaLibrariesScanQueue {
    + Writer: ChannelWriter<IMediaLibraryScanJob>
    + Reader: ChannelReader<IMediaLibraryScanJob>
}

class MediaLibrariesScanQueue {
    - _channel: Channel<IMediaLibraryScanJob>
    + Writer: ChannelWriter<IMediaLibraryScanJob>
    + Reader: ChannelReader<IMediaLibraryScanJob>
}

note bottom of MediaLibrariesScanQueue
  In-memory queue that receives only the root scan jobs of a
  scan. Children are triggered directly by their parents, and
  are never placed on this queue.
end note

class MediaLibraryScanJobProcessorJob {
    - _mediaScanQueue: IMediaLibrariesScanQueue
    - _mediaLibrariesScanCancellationTracker: IMediaLibrariesScanCancellationTracker
    # ExecuteAsync(token: CancellationToken): Task
}

note top of MediaLibraryScanJobProcessorJob
  Background service that launches the payload execution of the
  root scan jobs that arrive on the in-memory queue, firing them
  in a fire-and-forget manner without awaiting their long running
  payload execution (see ADR-0001, ADR-0009).
end note

