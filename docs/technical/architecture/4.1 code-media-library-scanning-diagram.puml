' ============================== SCAN JOBS ==============================

interface IMediaLibraryScanJob {
    + ScanId: ScanId
    + UserId: UserId
    + LibraryId: LibraryId
    + Children: List<IMediaLibraryScanJob>
    + Parents: List<IMediaLibraryScanJob>
    + Status: LibraryScanJobStatus
    + AddChild(job: IMediaLibraryScanJob)
    + AddParent(job: IMediaLibraryScanJob)
    + ExecuteAsync<TInput>(id: Guid, input: TInput, token: CancellationToken): Task
}

abstract class MediaLibraryScanJob {
    # parentsPayloadsExecuted: int
    + {abstract} ExecuteAsync<TInput>(id: Guid, input: TInput, token: CancellationToken): Task
}

note right of MediaLibraryScanJob
  Abstract base class for all media library scan jobs.
  Jobs form a directed acyclic graph: every job executes its
  payload only once all of its parents have completed, and
  then triggers its children. Each job creates its own DI
  scope through IServiceScopeFactory (see ADR-0001).
end note

