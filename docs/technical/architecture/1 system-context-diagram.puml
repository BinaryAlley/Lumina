@startuml Nemera System Context Diagram
!pragma layout elk
!include <C4/C4_Context>

LAYOUT_WITH_LEGEND()
title System Context diagram for Nemera Media Library Manager

Person(user, "Home User", "A person who wants to manage and stream their personal media collection")
Person(admin, "Administrator", "A person who manages the media library system")

System(nemera, "Nemera 1.1", "Allows users to organize, manage, stream and read their personal media content [detailed in '2 container-diagram.puml']")

System_Ext(metadataProvider, "Media Metadata and Artwork Services", "External services that provide media information and artwork (MusicBrainz, Open Library, Cover Art Archive)")

Rel(user, nemera, "Views, streams and reads media content")
Rel(admin, nemera, "Manages media library, plugins, themes and system settings")
Rel(nemera, metadataProvider, "Retrieves media metadata and artwork")

caption [System Context] Nemera

footer The system context diagram for the Nemera Media Library Manager - created with PlantUML

@enduml
