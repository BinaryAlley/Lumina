@startuml Lumina Container Diagram
!pragma layout elk
!include <C4/C4_Container>

LAYOUT_WITH_LEGEND()
title Container diagram for Lumina 1.1

Person(user, "Home User", "A person who wants to manage and stream their personal media collection")
Person(admin, "Administrator", "A person who manages the media library system")

System_Boundary(c1, "Lumina 1.1") {
    Container(webapp, "Web Application Client 2.1", "ASP.NET Core + Razor", "Delivers server-rendered views with dynamic client-side functionality for media management, playback, reading, favorites, playlists, statistics, plugins, themes, and the scheduled jobs dashboard [detailed in '3.1 component-web-client-diagram.puml']")

    Container(api, "API Server 2.2", "ASP.NET Core", "Provides media library management, plugin metadata and artwork, music playback, book reading, themes, favorites, playlists, consumption statistics, and scheduled maintenance through a REST API [detailed in '3.2 component-api-server-diagram.puml']")

    ContainerDb(db, "Database", "SQLite", "Stores user data, media metadata, library configuration, favorites, playlists, media consumption, plugins, themes, scheduled jobs and their executions")

    Container(filestore, "Media Store", "File System", "Stores the actual media files")

    Container(apiStorage, "API Local Storage", "File System", "API-private directories: the reading cache, the transcoding cache, the plugin store and the theme store")
}

System_Ext(metadata, "Media Metadata and Artwork Services", "External services like MusicBrainz, Open Library and Cover Art Archive, that provide media metadata and artwork")

Rel(user, webapp, "Uses", "HTTPS")
Rel(admin, webapp, "Manages media library, plugins, themes and system settings", "HTTPS")
Rel(webapp, api, "Makes API calls to", "JSON/HTTPS")
Rel(api, db, "Reads from and writes to", "SQL")
Rel(api, filestore, "Reads from and writes to")
Rel(api, apiStorage, "Reads from and writes to", "File system")
Rel(api, metadata, "Retrieves metadata and artwork from", "HTTPS")

caption [Container] Lumina 1.1

footer The container diagram for the Lumina 1.1 - created with PlantUML
@enduml
