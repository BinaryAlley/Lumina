class MediaLibraryScanTaskExecutor {
    - _unitOfWork: IUnitOfWork
    - _domainEventPublisher: IDomainEventPublisher
    + ExecutePayloadAsync(scheduledJob: ScheduledJob, token: CancellationToken): Task<Result<Success>>
}

note right of MediaLibraryScanTaskExecutor
  Executes the ScanMediaLibraries task on behalf of the owner of the
  scheduled job: queues a media library scan for every enabled and
  unlocked library that is not already being scanned, and lets the
  media library scanning subsystem process them.
end note

class TemporaryFilesCleanupTaskExecutor {
    + ExecutePayloadAsync(scheduledJob: ScheduledJob, token: CancellationToken): Task<Result<Success>>
}

note right of TemporaryFilesCleanupTaskExecutor
  Executes the CleanTemporaryFiles task: empties the temporary reading
  cache directory of the application, failing closed when the directory
  cannot be resolved safely inside the application base directory.
end note

