' ============================== READING HOST - APPLICATION CONTRACTS ==============================

interface IBookReadingService {
    + GetManifestAsync(bookId: Guid, libraryId: Guid, path: string, libraryType: LibraryType, shouldRenderPdfAsImages: bool, token: CancellationToken): Task<Result<ReadingManifestResponse>>
    + GetSectionAsync(bookId: Guid, libraryId: Guid, path: string, libraryType: LibraryType, locationRef: string, shouldRenderPdfAsImages: bool, shouldPreserveStyles: bool, token: CancellationToken): Task<Result<ReadingSectionDto>>
    + GetResourceAsync(bookId: Guid, libraryId: Guid, path: string, libraryType: LibraryType, resourceKey: string, shouldRenderPdfAsImages: bool, token: CancellationToken): Task<Result<ReadingResourceDataDto>>
    + GetAvailabilityAsync(bookId: Guid, libraryId: Guid, path: string, libraryType: LibraryType, token: CancellationToken): Task<Result<ReadingAvailabilityResponse>>
}

interface IBookReaderRegistry {
    + GetSupportedExtensionsByPluginId(): IReadOnlyDictionary<Guid, IReadOnlyList<string>>
}

interface IBookReaderEnablementCache {
    + Get(libraryId: Guid, pluginId: Guid): bool?
    + Set(libraryId: Guid, pluginId: Guid, isEnabled: bool)
    + Invalidate(libraryId: Guid, pluginId: Guid)
    + InvalidateLibrary(libraryId: Guid)
    + InvalidatePlugin(pluginId: Guid)
}

' ============================== READING HOST - INFRASTRUCTURE ==============================

class BookReadingService {
    - _extractions: ConcurrentDictionary<ReadingCacheKey, BookExtractionEntry>
    - _bookExtractionLocks: ConcurrentDictionary<ReadingCacheKey, SemaphoreSlim>
    - _pluginIdsByReaderKey: IReadOnlyDictionary<ReaderKey, Guid>
    - _enablementCache: IBookReaderEnablementCache
    + GetManifestAsync(...): Task<Result<ReadingManifestResponse>>
    + GetSectionAsync(...): Task<Result<ReadingSectionDto>>
    + GetResourceAsync(...): Task<Result<ReadingResourceDataDto>>
    + GetAvailabilityAsync(...): Task<Result<ReadingAvailabilityResponse>>
}

note right of BookReadingService
  Serves the manifest, sections and resources of a book:
  resolves the reader of the book format, checks the
  per-library enablement through the cache, reuses the already
  extracted document while the fingerprint of the book file is
  unchanged, extracts each rendering preference (text or page
  images) into its own directory under the reading cache, and
  produces on-demand resources (for example a PDF page render)
  once per resource file.
end note

class BookReaderRegistry {
    - _pluginManager: IPluginManager
    - _serviceProvider: IServiceProvider
    + GetSupportedExtensionsByPluginId(): IReadOnlyDictionary<Guid, IReadOnlyList<string>>
}

note right of BookReaderRegistry
  Reads the supported extensions live from the book readers
  registered by the loaded plugins, so that a plugin update
  that changes its formats never leaves stale configurations.
end note

class BookReaderEnablementCache {
    - _enablements: ConcurrentDictionary<(Guid LibraryId, Guid PluginId), bool>
    + Get(libraryId: Guid, pluginId: Guid): bool?
    + Set(libraryId: Guid, pluginId: Guid, isEnabled: bool)
    + Invalidate(libraryId: Guid, pluginId: Guid)
    + InvalidateLibrary(libraryId: Guid)
    + InvalidatePlugin(pluginId: Guid)
}

class ReadingCachePaths {
    + DIRECTORY_NAME: string = reading-cache
    + {static} GetRootDirectory(): string
}

note bottom of ReadingCachePaths
  The reading cache is a temporary directory in the API output,
  wiped at startup, under which every book keeps one directory
  per rendering preference (text and images).
end note

class ReadingContentSanitizer {
    + RESOURCE_ATTRIBUTE: string = data-lumina-resource
    + {static} Sanitize(html: string, shouldPreserveStyles: bool): string
}

note right of ReadingContentSanitizer
  Sanitizes every reading section with an explicit allowlist of
  inert markup, regardless of what the reader plugin produced;
  whether the style attribute survives is the per-user choice.
end note

' ============================== ENABLEMENT PERSISTENCE ==============================

