class LibraryBookReaderConfigurationRepository

class GetLibraryBookReadersQueryHandler {
    - _unitOfWork: IUnitOfWork
    - _bookReaderRegistry: IBookReaderRegistry
    + HandleAsync(query: GetLibraryBookReadersQuery, token: CancellationToken): Task<Result<IReadOnlyList<LibraryBookReaderResponse>>>
}

class SetLibraryBookReaderEnabledCommandHandler {
    - _unitOfWork: IUnitOfWork
    - _enablementCache: IBookReaderEnablementCache
    + HandleAsync(command: SetLibraryBookReaderEnabledCommand, token: CancellationToken): Task<Result<Success>>
}

note right of SetLibraryBookReaderEnabledCommandHandler
  Enables or disables the book reader of a plugin for a media
  library by upserting its configuration row, then invalidates
  the enablement cache so that a disabled reader stops being
  served immediately.
end note

' ============================== BOOK READER PLUGINS ==============================

interface IBookReader {
    + SupportedExtensions: IReadOnlyList<string>
    + SupportedLibraryTypes: IReadOnlyList<LibraryType>
    + OpenAsync(path: string, workingDirectory: string, shouldRenderPdfAsImages: bool, token: CancellationToken): Task<ReadingDocumentDto>
    + GetResourceAsync(path: string, workingDirectory: string, resourceKey: string, token: CancellationToken): Task<byte[]>
}

note top of IBookReader
  Contract of a reader plugin, implemented in Lumina.Plugins.Contracts.
  The plugins are host-trusted: they receive the absolute path of the
  book and a working directory to extract into, while the host
  sanitizes and contained-checks everything they produce before
  serving it to the client.
end note

class EpubReader {
}

note right of EpubReader
  Reads .epub books of the EBook and Book library types.
  EPUB is a ZIP archive, decoded entry by entry with bounded
  sizes and archive-contained paths.
end note

class EpubDocumentParser {
    + {static} Parse(epubPath: string, workingDirectory: string, token: CancellationToken): ReadingDocumentDto
}

class PdfReader {
}

note right of PdfReader
  Reads .pdf books of the EBook and Book library types.
  Each page is a reading section; the table of contents comes
  from the PDF bookmarks.
end note

class PdfDocumentParser {
    + {static} Parse(pdfPath: string, workingDirectory: string, shouldRenderPdfAsImages: bool, token: CancellationToken): ReadingDocumentDto
    + {static} RenderResource(pdfPath: string, resourceKey: string, token: CancellationToken): byte[]
}

note right of PdfDocumentParser
  Extracts the text layer of the pages with PdfPig, and renders
  the pages as images with PDFtoImage on demand when the
  render-as-images user setting is enabled; file size, page count
  and rendered page area are bounded.
end note

class EpubPlugin {
    + Id: Guid
    + Name: string = EPUB Reader
    + RegisterServices(services: IServiceCollection)
}

class PdfPlugin {
    + Id: Guid
    + Name: string = PDF Reader
    + RegisterServices(services: IServiceCollection)
}

' ============================== HOST IMPLEMENTATION RELATIONSHIPS ==============================

IBookReadingService <|.. BookReadingService : implements
IBookReaderRegistry <|.. BookReaderRegistry : implements
IBookReaderEnablementCache <|.. BookReaderEnablementCache : implements
ILibraryBookReaderConfigurationRepository <|.. LibraryBookReaderConfigurationRepository : implements

' ============================== READING HOST RELATIONSHIPS ==============================

BookReadingService --> IBookReaderRegistry : finds the plugin of the book format
BookReadingService --> IBookReaderEnablementCache : checks the per-library enablement
BookReadingService --> ILibraryBookReaderConfigurationRepository : fills the cache on a miss
BookReadingService ..> IBookReader : opens and produces resources
BookReadingService ..> ReadingContentSanitizer : sanitizes section content
BookReadingService ..> ReadingCachePaths : extracts into and serves from

BookReaderRegistry ..> IBookReader : reads the supported extensions of loaded plugins

' ============================== ENABLEMENT MANAGEMENT RELATIONSHIPS ==============================

GetLibraryBookReadersQueryHandler --> ILibraryBookReaderConfigurationRepository : reads configurations
GetLibraryBookReadersQueryHandler --> IBookReaderRegistry : reads supported extensions
SetLibraryBookReaderEnabledCommandHandler --> ILibraryBookReaderConfigurationRepository : upserts the configuration
SetLibraryBookReaderEnabledCommandHandler --> IBookReaderEnablementCache : invalidates the entry

ILibraryBookReaderConfigurationRepository --> LibraryBookReaderConfigurationEntity : persists

' ============================== BOOK READER PLUGIN RELATIONSHIPS ==============================

EpubReader <|.. IBookReader : implements
PdfReader <|.. IBookReader : implements

EpubReader ..> EpubDocumentParser : parses
PdfReader ..> PdfDocumentParser : parses and renders pages

EpubPlugin ..> EpubReader : registers as a keyed IBookReader
PdfPlugin ..> PdfReader : registers as a keyed IBookReader

