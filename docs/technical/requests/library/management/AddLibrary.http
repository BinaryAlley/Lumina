POST {{host}}/api/v1/libraries
Authorization: Bearer {{ACCESS_TOKEN}}
Content-Type: application/json

{
  "title": "Books",
  "libraryType": "Book",
  "contentLocations": [
    "/media/books"
  ],
  "coverImage": null,
  "isEnabled": true,
  "isLocked": false,
  "canDownloadMetadataFromWeb": true,
  "shouldSaveMetadataInMediaDirectories": true,
  "shouldSkipUnchangedDirectoriesDuringScan": true,
  "pathTemplateParts": [
    { "kind": "Artist", "representation": "{0}", "isOptional": false },
    { "kind": "Separator", "representation": "", "isOptional": false }
  ]
}
