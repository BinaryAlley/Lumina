@*
    FALLBACK MUSIC TRACK DETAILS / EDITING VIEW - READ BEFORE EDITING

    This view is the application fallback of the music track details and editing page, rendered only when the
    active theme does not provide its own template for the page. On a healthy site the page is presented by
    the theme files, which hook into the class names and element ids that this view uses as a contract, and
    which template the same fields rather than change which fields are offered.

    The view exposes every field a track stores, so that editing a track never drops any of its stored data.
    The audio properties, the release information, the language and original language, the work, the
    contributors, the ratings, the moods and the ISRCs are all editable, and they are all round-tripped on save.

    To change the behavior of the page, edit this script (and the theme template, when present). To restyle
    the page, edit the theme files. This fallback keeps every feature working without styling, so that a
    broken theme is obvious to the user while the page still functions.

    /library/audio-library/music-library/artists/{artistId}/albums/{albumId}/tracks/{trackId}?libraryId=...
*@

@using Lumina.Presentation.Web.Common.DTO.AudioLibrary.MusicLibrary
@using Lumina.Presentation.Web.Common.DTO.Common
@using Lumina.Presentation.Web.Common.Enums.AudioLibrary
@using Lumina.Presentation.Web.Common.Enums.Common
@using Lumina.Presentation.Web.Common.Enums.MediaContributors
@using Lumina.Presentation.Web.Common.Services
@using Microsoft.AspNetCore.Mvc.Localization
@using System
@using System.Globalization
@using System.Linq

@{
    // Generate a unique id for the scripts section of this view, so it can be dynamically loaded/unloaded by the global AJAX navigator handler.
    var scriptId = ScriptIdentifierHelper.GenerateScriptId();
    var trackId = Model.Id.ToString();
    var libraryId = Model.LibraryId.ToString();
    // The cover shown on the left is the cover of the album the track belongs to, passed in by the endpoint.
    var albumCoverPath = ViewData["AlbumCoverPath"]?.ToString() ?? string.Empty;
    // The track DTO does not carry the Id of its artist, so it is taken from the route that rendered the view.
    var artistId = Context.Request.RouteValues["artistId"]?.ToString() ?? string.Empty;
    var metadata = Model.Metadata;
    var work = Model.Work;
    var releaseInfo = metadata?.ReleaseInfo;
    var language = metadata?.Language;
    var originalLanguage = metadata?.OriginalLanguage;
    var workLanguages = work?.Languages ?? [];
    var genres = metadata?.Genres ?? [];
    var tags = metadata?.Tags ?? [];
    var moods = Model.Moods ?? [];
    var isrcs = Model.Isrcs ?? [];
    var contributors = Model.Contributors ?? [];
    var ratings = Model.Ratings ?? [];
    // Resolves the localized label of a release country, shown as "DE (Germany)", keyed by its ISO code.
    Func<string?, string> releaseCountryLabel = countryCode =>
    {
        if (string.IsNullOrEmpty(countryCode))
            return "-";
        string localizedName = _localizer[$"Country.{countryCode}"].Value;
        if (localizedName == $"Country.{countryCode}")
            return countryCode;
        return $"{countryCode} ({localizedName})";
    };
    var currentReleaseCountry = releaseInfo?.ReleaseCountry?.ToString() ?? string.Empty;
    // The localized options of the contributor roles and rating sources, serialized for the dynamic rows of the client script.
    var contributorRoleOptionsJson = System.Text.Json.JsonSerializer.Serialize(
        Enum.GetNames<MediaContributorRole>().Select(role => new { value = role, label = _localizer[role].Value }),
        new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase });
    var ratingSourceOptionsJson = System.Text.Json.JsonSerializer.Serialize(
        Enum.GetNames<AudioRatingSource>().Select(source => new { value = source, label = _localizer[source].Value }),
        new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase });
}

@inject IViewLocalizer _localizer
@inject IUrlService _urlService

@model MusicTrackDto

@Html.AntiForgeryToken()

<div style="display: grid; grid-template-rows: auto 1fr;"><!-- Container with two rows, one fixed, one filling remaining space. -->
    <div style="min-height: 1rem;"></div><!-- The first row is a dummy row for "margin", because setting a margin on the next row would offset the parent's position. -->
    <div class="enlightenment-panel shadow-effect mx-auto panel w-60 mb-10" style="min-width: 320px;">
        <div class="shine-effect"></div>
        <div class="form-row">
            <button id="btn-back-to-album" type="button" class="abort-button">@_localizer["BackToAlbum"]</button>
        </div>
        <div class="form-row">
            <h1 class="text-light-two w-100 text-center pt-0 pb-0 engraved-title">@_localizer["EditTrack"]</h1>
        </div>
        <div class="book-details-body">
            <!-- Cover, on the left. -->
            <div class="book-details-cover">
                <img id="album-cover-image" style="width: 300px; height: 300px; object-fit: cover; object-position: center;" data-cover-path="@albumCoverPath" alt="@(metadata?.Title ?? string.Empty)" />
            </div>
            <!-- Editable fields, on the right. -->
            <div class="book-details-form">
                <!-- General information. -->
                <h3 class="text-light-two">@_localizer["GeneralInformation"]</h3>
        <!-- Path. -->
        <div class="form-row">
            <div class="form-label"><label for="track-path">@_localizer["TrackPath"]</label>:</div>
            <div class="form-field"><input id="track-path" type="text" class="enlightenment-input" value="@(Model.Path ?? string.Empty)" /></div>
            <small class="form-label text-disabled form-description">@_localizer["TrackPathDescription"]</small>
        </div>
        <!-- Title. -->
        <div class="form-row">
            <div class="form-label"><label for="track-title">@_localizer["TrackTitle"]</label>:</div>
            <div class="form-field"><input id="track-title" type="text" class="enlightenment-input" value="@(metadata?.Title ?? string.Empty)" /></div>
            <small class="form-label text-disabled form-description">@_localizer["TrackTitleDescription"]</small>
        </div>
        <!-- Original title. -->
        <div class="form-row">
            <div class="form-label"><label for="track-original-title">@_localizer["TrackOriginalTitle"]</label>:</div>
            <div class="form-field"><input id="track-original-title" type="text" class="enlightenment-input" value="@(metadata?.OriginalTitle ?? string.Empty)" /></div>
            <small class="form-label text-disabled form-description">@_localizer["TrackOriginalTitleDescription"]</small>
        </div>
        <!-- Description. -->
        <div class="form-row">
            <div class="form-label"><label for="track-description">@_localizer["TrackDescription"]</label>:</div>
            <div class="form-field"><textarea id="track-description" class="enlightenment-input">@(metadata?.Description ?? string.Empty)</textarea></div>
            <small class="form-label text-disabled form-description">@_localizer["TrackDescriptionDescription"]</small>
        </div>
        <!-- Disambiguation. -->
        <div class="form-row">
            <div class="form-label"><label for="track-disambiguation">@_localizer["TrackDisambiguation"]</label>:</div>
            <div class="form-field"><input id="track-disambiguation" type="text" class="enlightenment-input" value="@(metadata?.Disambiguation ?? string.Empty)" /></div>
            <small class="form-label text-disabled form-description">@_localizer["TrackDisambiguationDescription"]</small>
        </div>
        <!-- Track number. -->
        <div class="form-row">
            <div class="form-label"><label for="track-track-number">@_localizer["TrackNumber"]</label>:</div>
            <div class="form-field"><input id="track-track-number" type="number" min="1" class="enlightenment-input" value="@(Model.TrackNumber.ToString(CultureInfo.InvariantCulture))" /></div>
            <small class="form-label text-disabled form-description">@_localizer["TrackNumberDescription"]</small>
        </div>
        <!-- Disc number. -->
        <div class="form-row">
            <div class="form-label"><label for="track-disc-number">@_localizer["DiscNumber"]</label>:</div>
            <div class="form-field"><input id="track-disc-number" type="number" min="1" class="enlightenment-input" value="@(Model.DiscNumber?.ToString(CultureInfo.InvariantCulture) ?? string.Empty)" /></div>
            <small class="form-label text-disabled form-description">@_localizer["DiscNumberDescription"]</small>
        </div>
        <!-- Script. -->
        <div class="form-row">
            <div class="form-label"><label for="track-script">@_localizer["Script"]</label>:</div>
            <div class="form-field"><input id="track-script" type="text" class="enlightenment-input" value="@(Model.Script ?? string.Empty)" /></div>
            <small class="form-label text-disabled form-description">@_localizer["ScriptDescription"]</small>
        </div>
        <!-- Musical key. -->
        <div class="form-row">
            <div class="form-label"><label for="track-key-combobox-toggle">@_localizer["Key"]</label>:</div>
            <div class="form-field">
                <div class="enlightenment-combobox inline-block w-100" id="track-key-combobox">
                    <div class="shine-effect" style="top: 1px;"></div>
                    <input type="checkbox" class="enlightenment-toggle-checkbox" id="track-key-combobox-toggle" />
                    <label class="enlightenment-toggle" for="track-key-combobox-toggle">
                        <span class="enlightenment-selected-text" data-value="@(Model.Key?.ToString() ?? string.Empty)">@(Model.Key.HasValue ? _localizer[Model.Key.Value.ToString()].Value : "-")</span>
                    </label>
                    <div class="enlightenment-dropdown">
                        <div class="enlightenment-option" data-value="">-</div>
                        @foreach (string key in Enum.GetNames<MusicKey>())
                        {
                            <div class="enlightenment-option" data-value="@key">@_localizer[key].Value</div>
                        }
                    </div>
                </div>
            </div>
            <small class="form-label text-disabled form-description">@_localizer["KeyDescription"]</small>
        </div>
        <!-- BPM. -->
        <div class="form-row">
            <div class="form-label"><label for="track-bpm">@_localizer["Bpm"]</label>:</div>
            <div class="form-field"><input id="track-bpm" type="number" min="0" class="enlightenment-input" value="@(Model.Bpm?.ToString(CultureInfo.InvariantCulture) ?? string.Empty)" /></div>
            <small class="form-label text-disabled form-description">@_localizer["BpmDescription"]</small>
        </div>
        <!-- Video recording. -->
        <div class="form-row">
            <div class="form-label"><label for="track-is-video">@_localizer["TrackIsVideo"]</label>:</div>
            <div class="form-field">
                <label class="enlightenment-checkbox-label">
                    <input id="track-is-video" type="checkbox" class="enlightenment-checkbox-hidden" @(metadata?.IsVideo == true ? "checked" : "") />
                    <span class="enlightenment-checkbox"></span>
                </label>
            </div>
            <small class="form-label text-disabled form-description">@_localizer["TrackIsVideoDescription"]</small>
        </div>
        <!-- Duration (seconds). -->
        <div class="form-row">
            <div class="form-label"><label for="track-duration">@_localizer["Duration"]</label>:</div>
            <div class="form-field"><input id="track-duration" type="number" min="0" class="enlightenment-input" value="@(metadata?.DurationInSeconds?.ToString(CultureInfo.InvariantCulture) ?? string.Empty)" /></div>
            <small class="form-label text-disabled form-description">@_localizer["DurationDescription"]</small>
        </div>
        <!-- Contributors. -->
        <h3 class="text-light-two">@_localizer["Contributors"]</h3>
        <div class="form-row">
            <table class="w-100 form-table">
                <thead>
                    <tr>
                        <th>@_localizer["ContributorId"]</th>
                        <th>@_localizer["ContributorRole"]</th>
                        <th class="w-40px"></th>
                    </tr>
                </thead>
                <tbody id="contributors-body">
                    @{ int contributorIndex = 0; }
                    @foreach (var contributor in contributors)
                    {
                        <tr class="contributor-row">
                            <td><input type="text" class="enlightenment-input contributor-id w-100" value="@(contributor.ContributorId.ToString())" /></td>
                            <td>
                                <div class="enlightenment-combobox inline-block w-100 contributor-role-combobox">
                                    <div class="shine-effect" style="top: 1px;"></div>
                                    <input type="checkbox" class="enlightenment-toggle-checkbox" id="contributor-role-toggle-@contributorIndex" />
                                    <label class="enlightenment-toggle" for="contributor-role-toggle-@contributorIndex">
                                        <span class="enlightenment-selected-text" data-value="@(contributor.Role?.ToString() ?? string.Empty)">@(contributor.Role.HasValue ? _localizer[contributor.Role.Value.ToString()].Value : "-")</span>
                                    </label>
                                    <div class="enlightenment-dropdown">
                                        <div class="enlightenment-option" data-value="">-</div>
                                        @foreach (string role in Enum.GetNames<MediaContributorRole>())
                                        {
                                            <div class="enlightenment-option" data-value="@role">@_localizer[role].Value</div>
                                        }
                                    </div>
                                </div>
                            </td>
                            <td><img src="~/images/ui/delete.svg" alt="@_localizer["Remove"]" title="@_localizer["Remove"]" class="remove-form-table-row-icon" /></td>
                        </tr>
                        contributorIndex++;
                    }
                </tbody>
            </table>
            <button id="btn-add-contributor" type="button" class="confirm-button">@_localizer["AddContributor"]</button>
            <small class="form-label text-disabled form-description">@_localizer["ContributorsDescription"]</small>
        </div>

        <!-- Ratings. -->
        <h3 class="text-light-two">@_localizer["Ratings"]</h3>
        <div class="form-row">
            <table class="w-100 form-table">
                <thead>
                    <tr>
                        <th>@_localizer["RatingValue"]</th>
                        <th>@_localizer["RatingMaxValue"]</th>
                        <th>@_localizer["RatingSource"]</th>
                        <th>@_localizer["RatingVoteCount"]</th>
                        <th class="w-40px"></th>
                    </tr>
                </thead>
                <tbody id="ratings-body">
                    @{ int ratingIndex = 0; }
                    @foreach (var rating in ratings)
                    {
                        <tr class="rating-row">
                            <td><input type="number" step="any" min="0" class="enlightenment-input rating-value w-100" value="@(rating.Value?.ToString(CultureInfo.InvariantCulture) ?? string.Empty)" /></td>
                            <td><input type="number" step="any" min="0" class="enlightenment-input rating-max-value w-100" value="@(rating.MaxValue?.ToString(CultureInfo.InvariantCulture) ?? string.Empty)" /></td>
                            <td>
                                <div class="enlightenment-combobox inline-block w-100 rating-source-combobox">
                                    <div class="shine-effect" style="top: 1px;"></div>
                                    <input type="checkbox" class="enlightenment-toggle-checkbox" id="rating-source-toggle-@ratingIndex" />
                                    <label class="enlightenment-toggle" for="rating-source-toggle-@ratingIndex">
                                        <span class="enlightenment-selected-text" data-value="@(rating.Source?.ToString() ?? string.Empty)">@(rating.Source.HasValue ? _localizer[rating.Source.Value.ToString()].Value : "-")</span>
                                    </label>
                                    <div class="enlightenment-dropdown">
                                        <div class="enlightenment-option" data-value="">-</div>
                                        @foreach (string source in Enum.GetNames<AudioRatingSource>())
                                        {
                                            <div class="enlightenment-option" data-value="@source">@_localizer[source].Value</div>
                                        }
                                    </div>
                                </div>
                            </td>
                            <td><input type="number" min="0" class="enlightenment-input rating-vote-count w-100" value="@(rating.VoteCount?.ToString(CultureInfo.InvariantCulture) ?? string.Empty)" /></td>
                            <td><img src="~/images/ui/delete.svg" alt="@_localizer["Remove"]" title="@_localizer["Remove"]" class="remove-form-table-row-icon" /></td>
                        </tr>
                        ratingIndex++;
                    }
                </tbody>
            </table>
            <button id="btn-add-rating" type="button" class="confirm-button">@_localizer["AddRating"]</button>
            <small class="form-label text-disabled form-description">@_localizer["RatingsDescription"]</small>
        </div>

        <!-- Genres. -->
        <h3 class="text-light-two">@_localizer["Genres"]</h3>
        <div class="form-row">
            <table class="w-100 form-table">
                <thead>
                    <tr>
                        <th>@_localizer["Genre"]</th>
                        <th class="w-40px"></th>
                    </tr>
                </thead>
                <tbody id="genres-body">
                    @foreach (var genre in genres)
                    {
                        <tr class="genre-row">
                            <td><input type="text" class="enlightenment-input genre-name w-100" value="@(genre.Name)" /></td>
                            <td><img src="~/images/ui/delete.svg" alt="@_localizer["Remove"]" title="@_localizer["Remove"]" class="remove-form-table-row-icon" /></td>
                        </tr>
                    }
                </tbody>
            </table>
            <button id="btn-add-genre" type="button" class="confirm-button">@_localizer["AddGenre"]</button>
            <small class="form-label text-disabled form-description">@_localizer["GenresDescription"]</small>
        </div>
        <!-- Tags. -->
        <h3 class="text-light-two">@_localizer["Tags"]</h3>
        <div class="form-row">
            <table class="w-100 form-table">
                <thead>
                    <tr>
                        <th>@_localizer["Tag"]</th>
                        <th class="w-40px"></th>
                    </tr>
                </thead>
                <tbody id="tags-body">
                    @foreach (var tag in tags)
                    {
                        <tr class="tag-row">
                            <td><input type="text" class="enlightenment-input tag-name w-100" value="@(tag.Name)" /></td>
                            <td><img src="~/images/ui/delete.svg" alt="@_localizer["Remove"]" title="@_localizer["Remove"]" class="remove-form-table-row-icon" /></td>
                        </tr>
                    }
                </tbody>
            </table>
            <button id="btn-add-tag" type="button" class="confirm-button">@_localizer["AddTag"]</button>
            <small class="form-label text-disabled form-description">@_localizer["TagsDescription"]</small>
        </div>

        <!-- Moods. -->
        <h3 class="text-light-two">@_localizer["Moods"]</h3>
        <div class="form-row">
            <table class="w-100 form-table">
                <thead>
                    <tr>
                        <th>@_localizer["Mood"]</th>
                        <th class="w-40px"></th>
                    </tr>
                </thead>
                <tbody id="moods-body">
                    @foreach (var mood in moods)
                    {
                        <tr class="mood-row">
                            <td><input type="text" class="enlightenment-input mood-name w-100" value="@(mood.Name)" /></td>
                            <td><img src="~/images/ui/delete.svg" alt="@_localizer["Remove"]" title="@_localizer["Remove"]" class="remove-form-table-row-icon" /></td>
                        </tr>
                    }
                </tbody>
            </table>
            <button id="btn-add-mood" type="button" class="confirm-button">@_localizer["AddMood"]</button>
            <small class="form-label text-disabled form-description">@_localizer["MoodsDescription"]</small>
        </div>
        <!-- Release information. -->
        <h3 class="text-light-two">@_localizer["TrackReleaseInformation"]</h3>
        <!-- Original release date. -->
        <div class="form-row">
            <div class="form-label"><label for="track-original-release-date">@_localizer["TrackOriginalReleaseDate"]</label>:</div>
            <div class="form-field"><input id="track-original-release-date" type="date" class="enlightenment-input" value="@(releaseInfo?.OriginalReleaseDate?.ToString("yyyy-MM-dd") ?? string.Empty)" /></div>
            <small class="form-label text-disabled form-description">@_localizer["TrackOriginalReleaseDateDescription"]</small>
        </div>
        <!-- Original release year. -->
        <div class="form-row">
            <div class="form-label"><label for="track-original-release-year">@_localizer["TrackOriginalReleaseYear"]</label>:</div>
            <div class="form-field"><input id="track-original-release-year" type="number" min="1" max="9999" class="enlightenment-input" value="@(releaseInfo?.OriginalReleaseYear?.ToString(CultureInfo.InvariantCulture) ?? string.Empty)" /></div>
            <small class="form-label text-disabled form-description">@_localizer["TrackOriginalReleaseYearDescription"]</small>
        </div>
        <!-- Re-release date. -->
        <div class="form-row">
            <div class="form-label"><label for="track-re-release-date">@_localizer["TrackReReleaseDate"]</label>:</div>
            <div class="form-field"><input id="track-re-release-date" type="date" class="enlightenment-input" value="@(releaseInfo?.ReReleaseDate?.ToString("yyyy-MM-dd") ?? string.Empty)" /></div>
            <small class="form-label text-disabled form-description">@_localizer["TrackReReleaseDateDescription"]</small>
        </div>
        <!-- Re-release year. -->
        <div class="form-row">
            <div class="form-label"><label for="track-re-release-year">@_localizer["TrackReReleaseYear"]</label>:</div>
            <div class="form-field"><input id="track-re-release-year" type="number" min="1" max="9999" class="enlightenment-input" value="@(releaseInfo?.ReReleaseYear?.ToString(CultureInfo.InvariantCulture) ?? string.Empty)" /></div>
            <small class="form-label text-disabled form-description">@_localizer["TrackReReleaseYearDescription"]</small>
        </div>
        <!-- Release country. -->
        <div class="form-row">
            <div class="form-label"><label for="track-release-country-combobox-toggle">@_localizer["TrackReleaseCountry"]</label>:</div>
            <div class="form-field">
                <div class="enlightenment-combobox inline-block w-100" id="track-release-country-combobox">
                    <div class="shine-effect" style="top: 1px;"></div>
                    <input type="checkbox" class="enlightenment-toggle-checkbox" id="track-release-country-combobox-toggle" />
                    <label class="enlightenment-toggle" for="track-release-country-combobox-toggle">
                        <span class="enlightenment-selected-text" data-value="@currentReleaseCountry">@releaseCountryLabel(currentReleaseCountry)</span>
                    </label>
                    <div class="enlightenment-dropdown">
                        <div class="enlightenment-option" data-value="">-</div>
                        @foreach (string country in Enum.GetNames<ReleaseCountry>())
                        {
                            <div class="enlightenment-option" data-value="@country">@releaseCountryLabel(country)</div>
                        }
                    </div>
                </div>
            </div>
            <small class="form-label text-disabled form-description">@_localizer["TrackReleaseCountryDescription"]</small>
        </div>
        <!-- Release version. -->
        <div class="form-row">
            <div class="form-label"><label for="track-release-version">@_localizer["TrackReleaseVersion"]</label>:</div>
            <div class="form-field"><input id="track-release-version" type="text" class="enlightenment-input" value="@(releaseInfo?.ReleaseVersion ?? string.Empty)" /></div>
            <small class="form-label text-disabled form-description">@_localizer["TrackReleaseVersionDescription"]</small>
        </div>

        <!-- Language. -->
        <h3 class="text-light-two">@_localizer["TrackLanguage"]</h3>
        <!-- Language code. -->
        <div class="form-row">
            <div class="form-label"><label for="track-language-code">@_localizer["LanguageCode"]</label>:</div>
            <div class="form-field"><input id="track-language-code" type="text" maxlength="2" class="enlightenment-input" value="@(language?.LanguageCode ?? string.Empty)" /></div>
            <small class="form-label text-disabled form-description">@_localizer["LanguageCodeDescription"]</small>
        </div>
        <!-- Language name. -->
        <div class="form-row">
            <div class="form-label"><label for="track-language-name">@_localizer["LanguageName"]</label>:</div>
            <div class="form-field"><input id="track-language-name" type="text" class="enlightenment-input" value="@(language?.LanguageName ?? string.Empty)" /></div>
            <small class="form-label text-disabled form-description">@_localizer["LanguageNameDescription"]</small>
        </div>
        <!-- Native name. -->
        <div class="form-row">
            <div class="form-label"><label for="track-language-native-name">@_localizer["NativeName"]</label>:</div>
            <div class="form-field"><input id="track-language-native-name" type="text" class="enlightenment-input" value="@(language?.NativeName ?? string.Empty)" /></div>
            <small class="form-label text-disabled form-description">@_localizer["NativeNameDescription"]</small>
        </div>
        <!-- Original language. -->
        <h3 class="text-light-two">@_localizer["TrackOriginalLanguage"]</h3>
        <!-- Language code. -->
        <div class="form-row">
            <div class="form-label"><label for="track-original-language-code">@_localizer["LanguageCode"]</label>:</div>
            <div class="form-field"><input id="track-original-language-code" type="text" maxlength="2" class="enlightenment-input" value="@(originalLanguage?.LanguageCode ?? string.Empty)" /></div>
            <small class="form-label text-disabled form-description">@_localizer["LanguageCodeDescription"]</small>
        </div>
        <!-- Language name. -->
        <div class="form-row">
            <div class="form-label"><label for="track-original-language-name">@_localizer["LanguageName"]</label>:</div>
            <div class="form-field"><input id="track-original-language-name" type="text" class="enlightenment-input" value="@(originalLanguage?.LanguageName ?? string.Empty)" /></div>
            <small class="form-label text-disabled form-description">@_localizer["LanguageNameDescription"]</small>
        </div>
        <!-- Native name. -->
        <div class="form-row">
            <div class="form-label"><label for="track-original-language-native-name">@_localizer["NativeName"]</label>:</div>
            <div class="form-field"><input id="track-original-language-native-name" type="text" class="enlightenment-input" value="@(originalLanguage?.NativeName ?? string.Empty)" /></div>
            <small class="form-label text-disabled form-description">@_localizer["NativeNameDescription"]</small>
        </div>

        <!-- Work. -->
        <h3 class="text-light-two">@_localizer["Work"]</h3>
        <!-- Work title. -->
        <div class="form-row">
            <div class="form-label"><label for="track-work-title">@_localizer["WorkTitle"]</label>:</div>
            <div class="form-field"><input id="track-work-title" type="text" class="enlightenment-input" value="@(work?.Title ?? string.Empty)" /></div>
            <small class="form-label text-disabled form-description">@_localizer["WorkTitleDescription"]</small>
        </div>
        <!-- Work MusicBrainz Id. -->
        <div class="form-row">
            <div class="form-label"><label for="track-work-musicbrainz-id">@_localizer["WorkMusicBrainzId"]</label>:</div>
            <div class="form-field"><input id="track-work-musicbrainz-id" type="text" class="enlightenment-input" value="@(work?.MusicBrainzWorkId?.ToString() ?? string.Empty)" /></div>
            <small class="form-label text-disabled form-description">@_localizer["WorkMusicBrainzIdDescription"]</small>
        </div>
        <!-- Work type. -->
        <div class="form-row">
            <div class="form-label"><label for="track-work-type">@_localizer["TrackWorkType"]</label>:</div>
            <div class="form-field"><input id="track-work-type" type="text" class="enlightenment-input" value="@(work?.Type ?? string.Empty)" /></div>
            <small class="form-label text-disabled form-description">@_localizer["TrackWorkTypeDescription"]</small>
        </div>
        <!-- Work ISWCs. -->
        <h4 class="text-light-two">@_localizer["TrackWorkIswcs"]</h4>
        <div class="form-row">
            <table class="w-100 form-table">
                <thead>
                    <tr>
                        <th>@_localizer["WorkIswc"]</th>
                        <th class="w-40px"></th>
                    </tr>
                </thead>
                <tbody id="work-iswcs-body">
                    @foreach (string workIswc in work?.Iswcs ?? [])
                    {
                        <tr class="work-iswc-row">
                            <td><input type="text" maxlength="20" class="enlightenment-input work-iswc-value w-100" value="@workIswc" /></td>
                            <td><img src="~/images/ui/delete.svg" alt="@_localizer["Remove"]" title="@_localizer["Remove"]" class="remove-form-table-row-icon" /></td>
                        </tr>
                    }
                </tbody>
            </table>
            <button id="btn-add-work-iswc" type="button" class="confirm-button">@_localizer["AddWorkIswc"]</button>
            <small class="form-label text-disabled form-description">@_localizer["TrackWorkIswcsDescription"]</small>
        </div>
        <!-- Work languages. -->
        <h4 class="text-light-two">@_localizer["TrackWorkLanguages"]</h4>
        <div class="form-row">
            <table class="w-100 form-table">
                <thead>
                    <tr>
                        <th>@_localizer["WorkLanguageCode"]</th>
                        <th>@_localizer["WorkLanguageName"]</th>
                        <th>@_localizer["WorkLanguageNativeName"]</th>
                        <th class="w-40px"></th>
                    </tr>
                </thead>
                <tbody id="work-languages-body">
                    @foreach (var workLanguage in workLanguages)
                    {
                        <tr class="work-language-row">
                            <td><input type="text" maxlength="2" class="enlightenment-input work-language-code w-100" value="@(workLanguage.LanguageCode ?? string.Empty)" /></td>
                            <td><input type="text" class="enlightenment-input work-language-name w-100" value="@(workLanguage.LanguageName ?? string.Empty)" /></td>
                            <td><input type="text" class="enlightenment-input work-language-native-name w-100" value="@(workLanguage.NativeName ?? string.Empty)" /></td>
                            <td><img src="~/images/ui/delete.svg" alt="@_localizer["Remove"]" title="@_localizer["Remove"]" class="remove-form-table-row-icon" /></td>
                        </tr>
                    }
                </tbody>
            </table>
            <button id="btn-add-work-language" type="button" class="confirm-button">@_localizer["AddWorkLanguage"]</button>
            <small class="form-label text-disabled form-description">@_localizer["TrackWorkLanguagesDescription"]</small>
        </div>

        <!-- ISRCs. -->
        <h3 class="text-light-two">@_localizer["Isrcs"]</h3>
        <div class="form-row">
            <table class="w-100 form-table">
                <thead>
                    <tr>
                        <th>@_localizer["Isrc"]</th>
                        <th class="w-40px"></th>
                    </tr>
                </thead>
                <tbody id="isrcs-body">
                    @foreach (var isrc in isrcs)
                    {
                        <tr class="isrc-row">
                            <td><input type="text" maxlength="12" class="enlightenment-input isrc-value w-100" value="@(isrc.Value)" /></td>
                            <td><img src="~/images/ui/delete.svg" alt="@_localizer["Remove"]" title="@_localizer["Remove"]" class="remove-form-table-row-icon" /></td>
                        </tr>
                    }
                </tbody>
            </table>
            <button id="btn-add-isrc" type="button" class="confirm-button">@_localizer["AddIsrc"]</button>
            <small class="form-label text-disabled form-description">@_localizer["IsrcsDescription"]</small>
        </div>

        <!-- Identifiers. -->
        <h3 class="text-light-two">@_localizer["Identifiers"]</h3>
        <!-- MusicBrainz recording Id. -->
        <div class="form-row">
            <div class="form-label"><label for="track-musicbrainz-recording-id">@_localizer["MusicBrainzRecordingId"]</label>:</div>
            <div class="form-field"><input id="track-musicbrainz-recording-id" type="text" class="enlightenment-input" value="@(Model.MusicBrainzRecordingId?.ToString() ?? string.Empty)" /></div>
            <small class="form-label text-disabled form-description">@_localizer["MusicBrainzRecordingIdDescription"]</small>
        </div>
        <!-- MusicBrainz track Id. -->
        <div class="form-row">
            <div class="form-label"><label for="track-musicbrainz-track-id">@_localizer["MusicBrainzTrackId"]</label>:</div>
            <div class="form-field"><input id="track-musicbrainz-track-id" type="text" class="enlightenment-input" value="@(Model.MusicBrainzTrackId?.ToString() ?? string.Empty)" /></div>
            <small class="form-label text-disabled form-description">@_localizer["MusicBrainzTrackIdDescription"]</small>
        </div>

        <!-- Audio properties. -->
        <h3 class="text-light-two">@_localizer["TrackAudioProperties"]</h3>
        <!-- Sample rate (Hz). -->
        <div class="form-row">
            <div class="form-label"><label for="track-sample-rate">@_localizer["TrackSampleRate"]</label>:</div>
            <div class="form-field"><input id="track-sample-rate" type="number" min="0" class="enlightenment-input" value="@(metadata?.SampleRate?.ToString(CultureInfo.InvariantCulture) ?? string.Empty)" /></div>
            <small class="form-label text-disabled form-description">@_localizer["TrackSampleRateDescription"]</small>
        </div>
        <!-- Channels. -->
        <div class="form-row">
            <div class="form-label"><label for="track-channels">@_localizer["TrackChannels"]</label>:</div>
            <div class="form-field"><input id="track-channels" type="number" min="0" class="enlightenment-input" value="@(metadata?.Channels?.ToString(CultureInfo.InvariantCulture) ?? string.Empty)" /></div>
            <small class="form-label text-disabled form-description">@_localizer["TrackChannelsDescription"]</small>
        </div>
        <!-- Bit depth. -->
        <div class="form-row">
            <div class="form-label"><label for="track-bit-depth">@_localizer["TrackBitDepth"]</label>:</div>
            <div class="form-field"><input id="track-bit-depth" type="number" min="0" class="enlightenment-input" value="@(metadata?.BitDepth?.ToString(CultureInfo.InvariantCulture) ?? string.Empty)" /></div>
            <small class="form-label text-disabled form-description">@_localizer["TrackBitDepthDescription"]</small>
        </div>
        <!-- Audio codec. -->
        <div class="form-row">
            <div class="form-label"><label for="track-audio-codec">@_localizer["TrackAudioCodec"]</label>:</div>
            <div class="form-field"><input id="track-audio-codec" type="text" class="enlightenment-input" value="@(metadata?.AudioCodec ?? string.Empty)" /></div>
            <small class="form-label text-disabled form-description">@_localizer["TrackAudioCodecDescription"]</small>
        </div>
        <!-- Bitrate (kbps). -->
        <div class="form-row">
            <div class="form-label"><label for="track-bitrate">@_localizer["TrackBitrate"]</label>:</div>
            <div class="form-field"><input id="track-bitrate" type="number" min="0" class="enlightenment-input" value="@(metadata?.Bitrate?.ToString(CultureInfo.InvariantCulture) ?? string.Empty)" /></div>
            <small class="form-label text-disabled form-description">@_localizer["TrackBitrateDescription"]</small>
        </div>
        <!-- AcoustID. -->
        <div class="form-row">
            <div class="form-label"><label for="track-acoustid">@_localizer["TrackAcoustId"]</label>:</div>
            <div class="form-field"><input id="track-acoustid" type="text" class="enlightenment-input" value="@(metadata?.AcoustId ?? string.Empty)" /></div>
            <small class="form-label text-disabled form-description">@_localizer["TrackAcoustIdDescription"]</small>
        </div>
        <!-- ReplayGain. -->
        <h4 class="text-light-two">@_localizer["TrackReplayGain"]</h4>
        <!-- Track gain (dB). -->
        <div class="form-row">
            <div class="form-label"><label for="track-replaygain-track-gain">@_localizer["TrackReplayGainTrackGain"]</label>:</div>
            <div class="form-field"><input id="track-replaygain-track-gain" type="number" step="any" class="enlightenment-input" value="@(metadata?.ReplayGainTrackGain?.ToString(CultureInfo.InvariantCulture) ?? string.Empty)" /></div>
            <small class="form-label text-disabled form-description">@_localizer["TrackReplayGainTrackGainDescription"]</small>
        </div>
        <!-- Track peak. -->
        <div class="form-row">
            <div class="form-label"><label for="track-replaygain-track-peak">@_localizer["TrackReplayGainTrackPeak"]</label>:</div>
            <div class="form-field"><input id="track-replaygain-track-peak" type="number" step="any" class="enlightenment-input" value="@(metadata?.ReplayGainTrackPeak?.ToString(CultureInfo.InvariantCulture) ?? string.Empty)" /></div>
            <small class="form-label text-disabled form-description">@_localizer["TrackReplayGainTrackPeakDescription"]</small>
        </div>
        <!-- Album gain (dB). -->
        <div class="form-row">
            <div class="form-label"><label for="track-replaygain-album-gain">@_localizer["TrackReplayGainAlbumGain"]</label>:</div>
            <div class="form-field"><input id="track-replaygain-album-gain" type="number" step="any" class="enlightenment-input" value="@(metadata?.ReplayGainAlbumGain?.ToString(CultureInfo.InvariantCulture) ?? string.Empty)" /></div>
            <small class="form-label text-disabled form-description">@_localizer["TrackReplayGainAlbumGainDescription"]</small>
        </div>
        <!-- Album peak. -->
        <div class="form-row">
            <div class="form-label"><label for="track-replaygain-album-peak">@_localizer["TrackReplayGainAlbumPeak"]</label>:</div>
            <div class="form-field"><input id="track-replaygain-album-peak" type="number" step="any" class="enlightenment-input" value="@(metadata?.ReplayGainAlbumPeak?.ToString(CultureInfo.InvariantCulture) ?? string.Empty)" /></div>
            <small class="form-label text-disabled form-description">@_localizer["TrackReplayGainAlbumPeakDescription"]</small>
        </div>

                <div class="form-row mt-10">
                    <button id="btn-save-track" type="button" class="confirm-button w-100px">@_localizer["Save"]</button>
                    <button id="btn-delete-track" type="button" class="abort-button w-100px">@_localizer["DeleteTrack"]</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- The "text/plain" type is a design choice, not a mistake: it keeps the browser from executing this view script during HTML parsing, before site.js defines the API helpers it calls. site.js (which loads deferred) executes these scripts once it is loaded, both on the initial page load and during AJAX navigation. -->
    <script type="text/plain" data-form="@scriptId">
        // Create cleanup registry for this view.
        const cleanupFunctions = [];
        let isInitialized = false;
        let generatedId = 1000;

        const artistId = '@artistId';
        const albumId = '@Model.AlbumId';
        const trackId = '@trackId';
        const libraryId = '@libraryId';
        const saveUrl = '@_urlService.GetAbsoluteUrl(WebRoutes.Music.SAVE_TRACK, new { artistId = default(Guid), albumId = default(Guid), trackId = default(Guid) })'.replace('/@(default(Guid))', `/${artistId}`).replace('/@(default(Guid))', `/${albumId}`).replace('/@(default(Guid))', `/${trackId}`);
        const deleteUrl = '@_urlService.GetAbsoluteUrl(WebRoutes.Music.DELETE_TRACK, new { artistId = default(Guid), albumId = default(Guid), trackId = default(Guid) })'.replace('/@(default(Guid))', `/${artistId}`).replace('/@(default(Guid))', `/${albumId}`).replace('/@(default(Guid))', `/${trackId}`);
        const albumUrl = '@_urlService.GetAbsoluteUrl(WebRoutes.Music.ALBUM, new { artistId = default(Guid), albumId = default(Guid) })'.replace('/@(default(Guid))', `/${artistId}`).replace('/@(default(Guid))', `/${albumId}`);

        // The element references are captured once, so that the cleanup can unbind their listeners even after the AJAX navigator has swapped the content out of the document.
        const btnBackToAlbum = document.getElementById('btn-back-to-album');
        const btnSaveTrack = document.getElementById('btn-save-track');
        const btnDeleteTrack = document.getElementById('btn-delete-track');
        const btnAddWorkLanguage = document.getElementById('btn-add-work-language');
        const btnAddGenre = document.getElementById('btn-add-genre');
        const btnAddTag = document.getElementById('btn-add-tag');
        const btnAddMood = document.getElementById('btn-add-mood');
        const btnAddIsrc = document.getElementById('btn-add-isrc');
        const btnAddWorkIswc = document.getElementById('btn-add-work-iswc');
        const btnAddContributor = document.getElementById('btn-add-contributor');
        const btnAddRating = document.getElementById('btn-add-rating');
        const workLanguagesBody = document.getElementById('work-languages-body');
        const genresBody = document.getElementById('genres-body');
        const tagsBody = document.getElementById('tags-body');
        const moodsBody = document.getElementById('moods-body');
        const isrcsBody = document.getElementById('isrcs-body');
        const workIswcsBody = document.getElementById('work-iswcs-body');
        const contributorsBody = document.getElementById('contributors-body');
        const ratingsBody = document.getElementById('ratings-body');

        const jsLocalizedStrings = {
            trackSaved: @Json.Serialize(_localizer["TrackSaved"].Value),
            saveFailed: @Json.Serialize(_localizer["SaveFailed"].Value),
            trackDeleted: @Json.Serialize(_localizer["TrackDeleted"].Value),
            deleteConfirm: @Json.Serialize(_localizer["DeleteConfirm"].Value),
            deleteFailed: @Json.Serialize(_localizer["DeleteFailed"].Value),
            remove: @Json.Serialize(_localizer["Remove"].Value)
        };

        // Reads the trimmed value of the element with the provided id.
        function readValue(id) {
            const element = document.getElementById(id);
            return element ? element.value.trim() : '';
        }

        // Reads the value of the enlightenment combobox with the provided id.
        function readComboboxValue(id) {
            const element = document.querySelector(`#${id} .enlightenment-selected-text`);
            return element ? (element.getAttribute('data-value') || '') : '';
        }

        // Reads the value of the enlightenment combobox inside the provided row, selected by its class.
        function readRowComboboxValue(row, className) {
            const element = row.querySelector(className + ' .enlightenment-selected-text');
            return element ? (element.getAttribute('data-value') || '') : '';
        }

        // Parses an integer value, returning null when the value is empty or not a number.
        function parseIntOrNull(value) {
            if (value.trim() === '')
                return null;
            const parsed = parseInt(value, 10);
            return Number.isNaN(parsed) ? null : parsed;
        }

        // Parses a decimal value, returning null when the value is empty or not a number.
        function parseOptionalDecimal(value) {
            if (value.trim() === '')
                return null;
            const parsed = Number(value);
            return Number.isNaN(parsed) ? null : parsed;
        }

        // Reads an optional number from a field, returning null when the field is empty or not a number.
        function readNumber(id) {
            const value = readValue(id);
            if (value === '')
                return null;
            const parsed = Number(value);
            return Number.isNaN(parsed) ? null : parsed;
        }

        // Reads an optional Guid from a field, returning null when the field is empty or not a valid Guid.
        function readGuid(id) {
            const value = readValue(id);
            if (!/^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$/.test(value))
                return null;
            return value;
        }

        // Reads the checked state of a checkbox element with the provided id.
        function readCheckbox(id) {
            const element = document.getElementById(id);
            return element ? element.checked === true : false;
        }

        // Builds the language object of a language group, or null when no field of the group carries a value.
        function buildLanguage(codeId, nameId, nativeNameId) {
            const code = readValue(codeId);
            const name = readValue(nameId);
            const nativeName = readValue(nativeNameId);
            if (code === '' && name === '' && nativeName === '')
                return null;
            return { LanguageCode: code || null, LanguageName: name || null, NativeName: nativeName || null };
        }

        // Builds the work object of the track, or null when there is no work (a work needs both a title and a MusicBrainz id).
        function buildWork() {
            const title = readValue('track-work-title');
            const musicBrainzId = readGuid('track-work-musicbrainz-id');
            if (title === '' || musicBrainzId === null)
                return null;
            return {
                MusicBrainzWorkId: musicBrainzId,
                Title: title,
                Type: readValue('track-work-type') || null,
                Languages: Array.from(workLanguagesBody.querySelectorAll('.work-language-row')).map(row => ({
                    LanguageCode: row.querySelector('.work-language-code').value.trim() || null,
                    LanguageName: row.querySelector('.work-language-name').value.trim() || null,
                    NativeName: row.querySelector('.work-language-native-name').value.trim() || null
                })),
                Iswcs: Array.from(workIswcsBody.querySelectorAll('.work-iswc-row')).map(row => row.querySelector('.work-iswc-value').value.trim()).filter(value => value !== '')
            };
        }

        // Builds the list of media contributor references from the contributor rows.
        function buildContributors() {
            return Array.from(contributorsBody.querySelectorAll('.contributor-row')).map(row => ({
                ContributorId: row.querySelector('.contributor-id').value.trim() || '00000000-0000-0000-0000-000000000000',
                Role: readRowComboboxValue(row, '.contributor-role-combobox') || null
            }));
        }

        // Builds the list of ratings from the rating rows.
        function buildRatings() {
            return Array.from(ratingsBody.querySelectorAll('.rating-row')).map(row => ({
                Value: parseOptionalDecimal(row.querySelector('.rating-value').value),
                MaxValue: parseOptionalDecimal(row.querySelector('.rating-max-value').value),
                Source: readRowComboboxValue(row, '.rating-source-combobox') || null,
                VoteCount: parseIntOrNull(row.querySelector('.rating-vote-count').value)
            }));
        }

        // Builds a list of name valued entries from the rows of a table, skipping the rows whose name is empty.
        function buildNameList(body, rowSelector, inputSelector) {
            return Array.from(body.querySelectorAll(rowSelector))
                .map(row => row.querySelector(inputSelector).value.trim())
                .filter(name => name !== '')
                .map(name => ({ Name: name }));
        }

        // Builds a list of value valued entries from the rows of a table, skipping the rows whose value is empty.
        function buildValueList(body, rowSelector, inputSelector) {
            return Array.from(body.querySelectorAll(rowSelector))
                .map(row => row.querySelector(inputSelector).value.trim())
                .filter(value => value !== '')
                .map(value => ({ Value: value }));
        }

        // Builds the payload of the edited track, matching the update request of the API.
        function buildPayload() {
            return {
                Path: readValue('track-path') || null,
                Metadata: {
                    Title: readValue('track-title'),
                    OriginalTitle: readValue('track-original-title') || null,
                    Description: readValue('track-description') || null,
                    Disambiguation: readValue('track-disambiguation') || null,
                    ReleaseInfo: {
                        OriginalReleaseDate: readValue('track-original-release-date') || null,
                        OriginalReleaseYear: readNumber('track-original-release-year'),
                        ReReleaseDate: readValue('track-re-release-date') || null,
                        ReReleaseYear: readNumber('track-re-release-year'),
                        ReleaseCountry: readComboboxValue('track-release-country-combobox') || null,
                        ReleaseVersion: readValue('track-release-version') || null
                    },
                    Language: buildLanguage('track-language-code', 'track-language-name', 'track-language-native-name'),
                    OriginalLanguage: buildLanguage('track-original-language-code', 'track-original-language-name', 'track-original-language-native-name'),
                    IsVideo: readCheckbox('track-is-video'),
                    DurationInSeconds: parseIntOrNull(readValue('track-duration')),
                    SampleRate: readNumber('track-sample-rate'),
                    Channels: readNumber('track-channels'),
                    BitDepth: readNumber('track-bit-depth'),
                    AudioCodec: readValue('track-audio-codec') || null,
                    Bitrate: readNumber('track-bitrate'),
                    AcoustId: readValue('track-acoustid') || null,
                    ReplayGainTrackGain: parseOptionalDecimal(readValue('track-replaygain-track-gain')),
                    ReplayGainTrackPeak: parseOptionalDecimal(readValue('track-replaygain-track-peak')),
                    ReplayGainAlbumGain: parseOptionalDecimal(readValue('track-replaygain-album-gain')),
                    ReplayGainAlbumPeak: parseOptionalDecimal(readValue('track-replaygain-album-peak')),
                    Genres: buildNameList(genresBody, '.genre-row', '.genre-name'),
                    Tags: buildNameList(tagsBody, '.tag-row', '.tag-name')
                },
                TrackNumber: parseIntOrNull(readValue('track-track-number')),
                DiscNumber: parseIntOrNull(readValue('track-disc-number')),
                Script: readValue('track-script') || null,
                Key: readComboboxValue('track-key-combobox') || null,
                Bpm: parseIntOrNull(readValue('track-bpm')),
                Work: buildWork(),
                MusicBrainzRecordingId: readGuid('track-musicbrainz-recording-id'),
                MusicBrainzTrackId: readGuid('track-musicbrainz-track-id'),
                Moods: buildNameList(moodsBody, '.mood-row', '.mood-name'),
                Isrcs: buildValueList(isrcsBody, '.isrc-row', '.isrc-value'),
                Contributors: buildContributors(),
                Ratings: buildRatings()
            };
        }

        // Builds the HTML of an enlightenment combobox of a row, with the provided options and an optional wrapper class.
        function buildRowCombobox(options, selectedValue, wrapperClass) {
            const id = `row-combobox-${generatedId++}`;
            const optionHtml = options.map(option =>
                `<div class="enlightenment-option" data-value="${option.value}">${option.label}</div>`).join('');
            return `
                <div class="enlightenment-combobox inline-block w-100 ${wrapperClass || ''}">
                    <div class="shine-effect" style="top: 1px;"></div>
                    <input type="checkbox" class="enlightenment-toggle-checkbox" id="${id}" />
                    <label class="enlightenment-toggle" for="${id}">
                        <span class="enlightenment-selected-text" data-value="${selectedValue || ''}">${selectedLabel(options, selectedValue)}</span>
                    </label>
                    <div class="enlightenment-dropdown">
                        <div class="enlightenment-option" data-value="">-</div>
                        ${optionHtml}
                    </div>
                </div>`;
        }

        // Returns the display text of a selected combobox value, using the default dash when nothing is selected.
        function selectedLabel(options, value) {
            if (!value)
                return '-';
            const option = options.find(item => item.value === value);
            return option ? option.label : value;
        }

        const contributorRoleOptions = @Html.Raw(contributorRoleOptionsJson);
        const ratingSourceOptions = @Html.Raw(ratingSourceOptionsJson);

        // Adds a blank work language row.
        function addWorkLanguageRow() {
            workLanguagesBody.insertAdjacentHTML('beforeend', `
                <tr class="work-language-row">
                    <td><input type="text" maxlength="2" class="enlightenment-input work-language-code w-100" /></td>
                    <td><input type="text" class="enlightenment-input work-language-name w-100" /></td>
                    <td><input type="text" class="enlightenment-input work-language-native-name w-100" /></td>
                    <td><img src="/images/ui/delete.svg" alt="${jsLocalizedStrings.remove}" title="${jsLocalizedStrings.remove}" class="remove-form-table-row-icon" /></td>
                </tr>`);
        }

        // Adds a blank genre row.
        function addGenreRow() {
            genresBody.insertAdjacentHTML('beforeend', `
                <tr class="genre-row">
                    <td><input type="text" class="enlightenment-input genre-name w-100" /></td>
                    <td><img src="/images/ui/delete.svg" alt="${jsLocalizedStrings.remove}" title="${jsLocalizedStrings.remove}" class="remove-form-table-row-icon" /></td>
                </tr>`);
        }

        // Adds a blank tag row.
        function addTagRow() {
            tagsBody.insertAdjacentHTML('beforeend', `
                <tr class="tag-row">
                    <td><input type="text" class="enlightenment-input tag-name w-100" /></td>
                    <td><img src="/images/ui/delete.svg" alt="${jsLocalizedStrings.remove}" title="${jsLocalizedStrings.remove}" class="remove-form-table-row-icon" /></td>
                </tr>`);
        }

        // Adds a blank mood row.
        function addMoodRow() {
            moodsBody.insertAdjacentHTML('beforeend', `
                <tr class="mood-row">
                    <td><input type="text" class="enlightenment-input mood-name w-100" /></td>
                    <td><img src="/images/ui/delete.svg" alt="${jsLocalizedStrings.remove}" title="${jsLocalizedStrings.remove}" class="remove-form-table-row-icon" /></td>
                </tr>`);
        }

        // Adds a blank ISRC row.
        function addIsrcRow() {
            isrcsBody.insertAdjacentHTML('beforeend', `
                <tr class="isrc-row">
                    <td><input type="text" maxlength="12" class="enlightenment-input isrc-value w-100" /></td>
                    <td><img src="/images/ui/delete.svg" alt="${jsLocalizedStrings.remove}" title="${jsLocalizedStrings.remove}" class="remove-form-table-row-icon" /></td>
                </tr>`);
        }

        // Adds a blank work ISWC row.
        function addWorkIswcRow() {
            workIswcsBody.insertAdjacentHTML('beforeend', `
                <tr class="work-iswc-row">
                    <td><input type="text" maxlength="20" class="enlightenment-input work-iswc-value w-100" /></td>
                    <td><img src="/images/ui/delete.svg" alt="${jsLocalizedStrings.remove}" title="${jsLocalizedStrings.remove}" class="remove-form-table-row-icon" /></td>
                </tr>`);
        }

        // Adds a blank contributor row.
        function addContributorRow() {
            contributorsBody.insertAdjacentHTML('beforeend', `
                <tr class="contributor-row">
                    <td><input type="text" class="enlightenment-input contributor-id w-100" /></td>
                    <td>${buildRowCombobox(contributorRoleOptions, '', 'contributor-role-combobox')}</td>
                    <td><img src="/images/ui/delete.svg" alt="${jsLocalizedStrings.remove}" title="${jsLocalizedStrings.remove}" class="remove-form-table-row-icon" /></td>
                </tr>`);
        }

        // Adds a blank rating row.
        function addRatingRow() {
            ratingsBody.insertAdjacentHTML('beforeend', `
                <tr class="rating-row">
                    <td><input type="number" step="any" min="0" class="enlightenment-input rating-value w-100" /></td>
                    <td><input type="number" step="any" min="0" class="enlightenment-input rating-max-value w-100" /></td>
                    <td>${buildRowCombobox(ratingSourceOptions, '', 'rating-source-combobox')}</td>
                    <td><input type="number" min="0" class="enlightenment-input rating-vote-count w-100" /></td>
                    <td><img src="/images/ui/delete.svg" alt="${jsLocalizedStrings.remove}" title="${jsLocalizedStrings.remove}" class="remove-form-table-row-icon" /></td>
                </tr>`);
        }

        // Removes the row of the clicked remove icon.
        function handleRowRemoval(event) {
            if (event.target.matches('.remove-form-table-row-icon'))
                event.target.closest('tr').remove();
        }

        // Sends the edited track data to the server.
        async function handleSaveAsync() {
            const result = await callApiPutAsync(`${saveUrl}?libraryId=${encodeURIComponent(libraryId)}`, buildPayload());
            if (result && result.success === true) {
                notificationService.show(jsLocalizedStrings.trackSaved, NotificationType.SUCCESS);
            } else {
                notificationService.show(jsLocalizedStrings.saveFailed, NotificationType.ERROR);
            }
        }

        // Deletes the track after confirmation, then returns to the album page.
        async function handleDeleteAsync() {
            if (await dialogService.show(jsLocalizedStrings.deleteConfirm, jsLocalizedDialogs.confirmation, DialogButtons.YES_NO, DialogIcon.QUESTION) !== DialogButton.YES)
                return;
            const success = await callApiDeleteAsync(`${deleteUrl}?libraryId=${encodeURIComponent(libraryId)}`);
            if (success) {
                notificationService.show(jsLocalizedStrings.trackDeleted, NotificationType.SUCCESS);
                await updateContentAsync(buildAlbumUrl(), true);
            } else {
                notificationService.show(jsLocalizedStrings.deleteFailed, NotificationType.ERROR);
            }
        }

        // Builds the URL of the album page of the track.
        function buildAlbumUrl() {
            return albumUrl + `?libraryId=${libraryId}`;
        }

        // Navigates back to the album page.
        async function handleBackToAlbumAsync() {
            await updateContentAsync(buildAlbumUrl(), true);
        }

        // Add listeners.
        btnSaveTrack.addEventListener('click', handleSaveAsync);
        btnDeleteTrack.addEventListener('click', handleDeleteAsync);
        btnBackToAlbum.addEventListener('click', handleBackToAlbumAsync);
        btnAddWorkLanguage.addEventListener('click', addWorkLanguageRow);
        btnAddGenre.addEventListener('click', addGenreRow);
        btnAddTag.addEventListener('click', addTagRow);
        btnAddMood.addEventListener('click', addMoodRow);
        btnAddIsrc.addEventListener('click', addIsrcRow);
        btnAddWorkIswc.addEventListener('click', addWorkIswcRow);
        btnAddContributor.addEventListener('click', addContributorRow);
        btnAddRating.addEventListener('click', addRatingRow);
        workLanguagesBody.addEventListener('click', handleRowRemoval);
        genresBody.addEventListener('click', handleRowRemoval);
        tagsBody.addEventListener('click', handleRowRemoval);
        moodsBody.addEventListener('click', handleRowRemoval);
        isrcsBody.addEventListener('click', handleRowRemoval);
        workIswcsBody.addEventListener('click', handleRowRemoval);
        contributorsBody.addEventListener('click', handleRowRemoval);
        ratingsBody.addEventListener('click', handleRowRemoval);
        document.addEventListener('DOMContentLoaded', InitializeAsync);

        // Register cleanup for these listeners.
        cleanupFunctions.push(() => {
            btnSaveTrack.removeEventListener('click', handleSaveAsync);
            btnDeleteTrack.removeEventListener('click', handleDeleteAsync);
            btnBackToAlbum.removeEventListener('click', handleBackToAlbumAsync);
            btnAddWorkLanguage.removeEventListener('click', addWorkLanguageRow);
            btnAddGenre.removeEventListener('click', addGenreRow);
            btnAddTag.removeEventListener('click', addTagRow);
            btnAddMood.removeEventListener('click', addMoodRow);
            btnAddIsrc.removeEventListener('click', addIsrcRow);
            btnAddWorkIswc.removeEventListener('click', addWorkIswcRow);
            btnAddContributor.removeEventListener('click', addContributorRow);
            btnAddRating.removeEventListener('click', addRatingRow);
            workLanguagesBody.removeEventListener('click', handleRowRemoval);
            genresBody.removeEventListener('click', handleRowRemoval);
            tagsBody.removeEventListener('click', handleRowRemoval);
            moodsBody.removeEventListener('click', handleRowRemoval);
            isrcsBody.removeEventListener('click', handleRowRemoval);
            workIswcsBody.removeEventListener('click', handleRowRemoval);
            contributorsBody.removeEventListener('click', handleRowRemoval);
            ratingsBody.removeEventListener('click', handleRowRemoval);
            document.removeEventListener('DOMContentLoaded', InitializeAsync);
        });

        // Initializes the page.
        function InitializeAsync() {
            if (isInitialized)
                return;
            isInitialized = true;

            // The stored cover path is relative to the API, so the cover of the album is resolved against the API base and a placeholder is shown when there is none.
            const albumCoverImage = document.getElementById('album-cover-image');
            if (albumCoverImage)
                albumCoverImage.src = albumCoverImage.dataset.coverPath
                    ? `${globalConfiguration.serverBasePath}${albumCoverImage.dataset.coverPath}`
                    : '/images/ui/music-placeholder.svg';
        }

        // Store all cleanups for this view on window object using the scriptId.
        window.viewCleanups = window.viewCleanups || {};
        window.viewCleanups['@scriptId'] = () => {
            cleanupFunctions.forEach(cleanup => cleanup());
            console.log(`Unloaded @scriptId`);
        };
        console.log(`Loaded @scriptId`);
    </script>
}
