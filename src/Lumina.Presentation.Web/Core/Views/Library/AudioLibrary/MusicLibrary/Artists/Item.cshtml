@*
    FALLBACK MUSIC ARTIST DETAILS / EDITING VIEW - READ BEFORE EDITING

    This view is the application fallback of the music artist details and editing page, rendered only when the
    active theme does not provide its own template for the page. On a healthy site the page is presented
    by the theme files, which hook into the class names and element ids that this view uses as a contract,
    exactly like the media library editing page.

    The albums of the artist are NOT edited inline: they are listed as cards that navigate to their own pages,
    and the update request only round-trips the albums unchanged, so that updating the artist never drops them.

    The artist header exposes a play all trigger for the global audio player. The player handles the trigger by event
    delegation, so this view binds no playback listener; the trigger attribute contract lives in docs/technical/theming/Theming.md.

    To change the behavior of the page, edit this script (and the theme template, when present). To restyle
    the page, edit the theme files. This fallback keeps every feature working without styling, so that a
    broken theme is obvious to the user while the page still functions.

    /library/audio-library/music-library/artists/{artistId}?libraryId=...
*@

@using Lumina.Presentation.Web.Common.DTO.AudioLibrary.MusicLibrary
@using Lumina.Presentation.Web.Common.Enums.AudioLibrary
@using Lumina.Presentation.Web.Common.Enums.Common
@using Lumina.Presentation.Web.Common.Enums.MediaContributors
@using Lumina.Presentation.Web.Common.Services
@using Microsoft.AspNetCore.Mvc.Localization
@using System
@using System.Globalization
@using System.Linq

@{
    // Generate a unique id for the scripts section of this view, so it can be dynamically loaded/unloaded by the global AJAX navigator handler.
    var scriptId = ScriptIdentifierHelper.GenerateScriptId();

    var artistId = Model.Id.ToString();
    var libraryId = Model.LibraryId.ToString();
    var metadata = Model.Metadata;
    var aliases = metadata?.Aliases ?? [];
    var contributors = Model.Contributors ?? [];
    var ratings = Model.Ratings ?? [];
    // The play all trigger starts disabled when the artist is already known to hold no releases, so an empty discography
    // cannot be clicked before the release list request resolves. A failed request never changes this state.
    var hasReleases = (Model.Albums?.Count ?? 0) > 0;
    var genres = metadata?.Genres ?? [];
    var tags = metadata?.Tags ?? [];
    var area = metadata?.Area;
    var beginArea = metadata?.BeginArea;
    var endArea = metadata?.EndArea;
    // Resolves the localized label of a release country, shown as "DE (Germany)", keyed by its ISO code.
    Func<string?, string> releaseCountryLabel = countryCode =>
    {
        if (string.IsNullOrEmpty(countryCode))
            return "-";
        string localizedName = _localizer[$"Country.{countryCode}"].Value;
        if (localizedName == $"Country.{countryCode}")
            return countryCode;
        return $"{countryCode} ({localizedName})";
    };
    // The baseline of the albums of the artist, mapped to the update request shape, so that the update round-trips them unchanged.
    var albumsBaseline = (Model.Albums ?? []).Select(album => new
    {
        AlbumId = album.Id,
        Metadata = album.Metadata,
        MediaFormat = album.MediaFormat,
        Packaging = album.Packaging,
        Barcode = album.Barcode,
        CatalogNumbers = album.CatalogNumbers,
        Label = album.Label,
        ASIN = album.ASIN,
        MusicBrainzReleaseId = album.MusicBrainzReleaseId,
        MusicBrainzReleaseGroupId = album.MusicBrainzReleaseGroupId,
        MusicBrainzReleaseArtistId = album.MusicBrainzReleaseArtistId,
        Contributors = album.Contributors,
        Ratings = album.Ratings,
        Tracks = (album.Tracks ?? []).Select(track => new
        {
            TrackId = track.Id,
            Path = track.Path,
            Metadata = track.Metadata,
            TrackNumber = track.TrackNumber,
            DiscNumber = track.DiscNumber,
            Script = track.Script,
            Key = track.Key,
            Bpm = track.Bpm,
            Work = track.Work,
            MusicBrainzRecordingId = track.MusicBrainzRecordingId,
            MusicBrainzTrackId = track.MusicBrainzTrackId,
            Moods = track.Moods,
            Isrcs = track.Isrcs,
            Contributors = track.Contributors,
            Ratings = track.Ratings
        })
    });
    var albumsBaselineJson = System.Text.Json.JsonSerializer.Serialize(albumsBaseline, new System.Text.Json.JsonSerializerOptions { Converters = { new System.Text.Json.Serialization.JsonStringEnumConverter() } });
    // The localized options of the contributor roles and rating sources, serialized for the dynamic rows of the client script.
    var contributorRoleOptionsJson = System.Text.Json.JsonSerializer.Serialize(
        Enum.GetNames<MediaContributorRole>().Select(role => new { value = role, label = _localizer[role].Value }),
        new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase });
    var ratingSourceOptionsJson = System.Text.Json.JsonSerializer.Serialize(
        Enum.GetNames<AudioRatingSource>().Select(source => new { value = source, label = _localizer[source].Value }),
        new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase });
}

@inject IViewLocalizer _localizer
@inject IUrlService _urlService

@model MusicArtistDto

@Html.AntiForgeryToken()

<div style="display: grid; grid-template-rows: auto 1fr;"><!-- Container with two rows, one fixed, one filling remaining space. -->
    <!-- The first row is a dummy row for "margin", because setting a margin on the next row would offset the parent's position. -->
    <div style="min-height: 1rem;"></div>
    <div class="enlightenment-panel shadow-effect mx-auto panel w-60 mb-10" style="min-width: 320px;">
        <div class="shine-effect"></div>
        <div class="form-row">
            <button id="btn-back-to-artists" type="button" class="abort-button">@_localizer["BackToArtists"]</button>
            <!-- The play all trigger is handled by the global audio player script through event delegation, so this page binds no click handler of its own. -->
            <button id="btn-play-artist" type="button" class="confirm-button" @(hasReleases ? string.Empty : "disabled")
                    data-audio-player-play
                    data-library-id="@libraryId"
                    data-artist-id="@artistId"
                    data-title="@(metadata?.Name ?? string.Empty)"
                    data-cover-art-path="@(Model.CoverPath ?? string.Empty)">
                @_localizer["PlayAll"]
            </button>
        </div>
        <div class="form-row">
            <h1 class="text-light-two w-100 text-center pt-0 pb-0 engraved-title">@_localizer["EditArtist"]</h1>
        </div>
        <div class="book-details-body">
            <!-- Cover, on the left. -->
            <div class="book-details-cover">
                <img id="artist-cover-image" style="width: 300px; height: 300px; object-fit: cover; object-position: center;" data-cover-path="@(Model.CoverPath ?? string.Empty)" alt="@_localizer["CoverImage"]" />
                <div class="form-row">
                    <button id="btn-change-cover" type="button" class="confirm-button">@_localizer["ChangeCover"]</button>
                    <input id="artist-cover-input" type="file" accept="image/*" class="hidden" />
                </div>
                <div class="form-row">
                    <small id="artist-cover-path" class="book-cover-path text-disabled" title="@(Model.CoverPath ?? string.Empty)">@(Model.CoverPath ?? _localizer["NoCover"].Value)</small>
                </div>
            </div>
            <!-- Editable fields, on the right. -->
            <div class="book-details-form">
        <!-- Releases. -->
        <h3 class="text-light-two">@_localizer["Releases"]</h3>
        <!-- Albums. -->
        <div class="form-row">
            <div id="albums-container" style="width: 100%;">
                <p id="no-albums" class="hidden text-light-two">@_localizer["NoAlbums"]</p>
            </div>
        </div>

        <!-- General information. -->
        <h3 class="text-light-two">@_localizer["GeneralInformation"]</h3>
        <!-- Name. -->
        <div class="form-row">
            <div class="form-label"><label for="artist-name-input">@_localizer["Name"]</label><span class="mandatory-field">*</span>:</div>
            <div class="form-field"><input id="artist-name-input" type="text" class="enlightenment-input" value="@(metadata?.Name ?? string.Empty)" /></div>
            <small class="form-label text-disabled form-description">@_localizer["NameDescription"]</small>
        </div>
        <!-- Sort name. -->
        <div class="form-row">
            <div class="form-label"><label for="artist-sort-name-input">@_localizer["SortName"]</label>:</div>
            <div class="form-field"><input id="artist-sort-name-input" type="text" class="enlightenment-input" value="@(metadata?.SortName ?? string.Empty)" /></div>
            <small class="form-label text-disabled form-description">@_localizer["SortNameDescription"]</small>
        </div>
        <!-- Disambiguation. -->
        <div class="form-row">
            <div class="form-label"><label for="artist-disambiguation-input">@_localizer["Disambiguation"]</label>:</div>
            <div class="form-field"><input id="artist-disambiguation-input" type="text" class="enlightenment-input" value="@(metadata?.Disambiguation ?? string.Empty)" /></div>
            <small class="form-label text-disabled form-description">@_localizer["DisambiguationDescription"]</small>
        </div>
        <!-- Type. -->
        <div class="form-row">
            <div class="form-label"><label for="artist-type-combobox-toggle">@_localizer["Type"]</label>:</div>
            <div class="form-field">
                <div class="enlightenment-combobox inline-block w-100" id="artist-type-combobox">
                    <div class="shine-effect" style="top: 1px;"></div>
                    <input type="checkbox" class="enlightenment-toggle-checkbox" id="artist-type-combobox-toggle" />
                    <label class="enlightenment-toggle" for="artist-type-combobox-toggle">
                        <span class="enlightenment-selected-text" data-value="@(metadata?.Type?.ToString() ?? string.Empty)">@(metadata is not null && metadata.Type.HasValue ? _localizer[metadata.Type.Value.ToString()].Value : "-")</span>
                    </label>
                    <div class="enlightenment-dropdown">
                        <div class="enlightenment-option" data-value="">-</div>
                        @foreach (string type in Enum.GetNames<MusicArtistType>())
                        {
                            <div class="enlightenment-option" data-value="@type">@_localizer[type].Value</div>
                        }
                    </div>
                </div>
            </div>
            <small class="form-label text-disabled form-description">@_localizer["TypeDescription"]</small>
        </div>
        <!-- Gender. -->
        <div class="form-row">
            <div class="form-label"><label for="artist-gender-combobox-toggle">@_localizer["Gender"]</label>:</div>
            <div class="form-field">
                <div class="enlightenment-combobox inline-block w-100" id="artist-gender-combobox">
                    <div class="shine-effect" style="top: 1px;"></div>
                    <input type="checkbox" class="enlightenment-toggle-checkbox" id="artist-gender-combobox-toggle" />
                    <label class="enlightenment-toggle" for="artist-gender-combobox-toggle">
                        <span class="enlightenment-selected-text" data-value="@(metadata?.Gender?.ToString() ?? string.Empty)">@(metadata is not null && metadata.Gender.HasValue ? _localizer[metadata.Gender.Value.ToString()].Value : "-")</span>
                    </label>
                    <div class="enlightenment-dropdown">
                        <div class="enlightenment-option" data-value="">-</div>
                        @foreach (string gender in Enum.GetNames<MusicArtistGender>())
                        {
                            <div class="enlightenment-option" data-value="@gender">@_localizer[gender].Value</div>
                        }
                    </div>
                </div>
            </div>
            <small class="form-label text-disabled form-description">@_localizer["GenderDescription"]</small>
        </div>
        <!-- Country. -->
        <div class="form-row">
            <div class="form-label"><label for="artist-country-input">@_localizer["Country"]</label>:</div>
            <div class="form-field"><input id="artist-country-input" type="text" maxlength="2" class="enlightenment-input" value="@(metadata?.Country ?? string.Empty)" /></div>
            <small class="form-label text-disabled form-description">@_localizer["CountryDescription"]</small>
        </div>
        <!-- Website. -->
        <div class="form-row">
            <div class="form-label"><label for="artist-website-input">@_localizer["Website"]</label>:</div>
            <div class="form-field"><input id="artist-website-input" type="text" class="enlightenment-input" value="@(Model.Website ?? string.Empty)" /></div>
            <small class="form-label text-disabled form-description">@_localizer["WebsiteDescription"]</small>
        </div>
        <!-- MusicBrainz artist Id. -->
        <div class="form-row">
            <div class="form-label"><label for="artist-musicbrainz-id-input">@_localizer["MusicBrainzArtistId"]</label>:</div>
            <div class="form-field"><input id="artist-musicbrainz-id-input" type="text" class="enlightenment-input" value="@(Model.MusicBrainzArtistId?.ToString() ?? string.Empty)" /></div>
            <small class="form-label text-disabled form-description">@_localizer["MusicBrainzArtistIdDescription"]</small>
        </div>
        <!-- Begin date. -->
        <div class="form-row">
            <div class="form-label"><label for="artist-lifespan-begin-input">@_localizer["LifeSpanBegin"]</label>:</div>
            <div class="form-field"><input id="artist-lifespan-begin-input" type="date" class="enlightenment-input" value="@(metadata?.LifeSpanBegin?.ToString("yyyy-MM-dd") ?? string.Empty)" /></div>
            <small class="form-label text-disabled form-description">@_localizer["LifeSpanBeginDescription"]</small>
        </div>
        <!-- End date. -->
        <div class="form-row">
            <div class="form-label"><label for="artist-lifespan-end-input">@_localizer["LifeSpanEnd"]</label>:</div>
            <div class="form-field"><input id="artist-lifespan-end-input" type="date" class="enlightenment-input" value="@(metadata?.LifeSpanEnd?.ToString("yyyy-MM-dd") ?? string.Empty)" /></div>
            <small class="form-label text-disabled form-description">@_localizer["LifeSpanEndDescription"]</small>
        </div>
        <!-- Ended. -->
        <div class="form-row">
            <div class="form-label"><label for="artist-is-ended-input">@_localizer["IsEnded"]</label>:</div>
            <div class="form-field">
                <label class="enlightenment-checkbox-label">
                    <input id="artist-is-ended-input" type="checkbox" class="enlightenment-checkbox-hidden" @(metadata?.IsEnded == true ? "checked" : "") />
                    <span class="enlightenment-checkbox"></span>
                </label>
            </div>
            <small class="form-label text-disabled form-description">@_localizer["IsEndedDescription"]</small>
        </div>

        <!-- Contributors. -->
        <h3 class="text-light-two">@_localizer["Contributors"]</h3>
        <!-- Contributors table. -->
        <div class="form-row">
            <table class="w-100 form-table">
                <thead>
                    <tr>
                        <th>@_localizer["ContributorId"]</th>
                        <th>@_localizer["ContributorRole"]</th>
                        <th class="w-40px"></th>
                    </tr>
                </thead>
                <tbody id="contributors-body">
                    @{ int contributorIndex = 0; }
                    @foreach (var contributor in contributors)
                    {
                        <tr class="contributor-row">
                            <td><input type="text" class="enlightenment-input contributor-id w-100" value="@(contributor.ContributorId.ToString())" /></td>
                            <td>
                                <div class="enlightenment-combobox inline-block w-100 contributor-role-combobox">
                                    <div class="shine-effect" style="top: 1px;"></div>
                                    <input type="checkbox" class="enlightenment-toggle-checkbox" id="contributor-role-toggle-@contributorIndex" />
                                    <label class="enlightenment-toggle" for="contributor-role-toggle-@contributorIndex">
                                        <span class="enlightenment-selected-text" data-value="@(contributor.Role?.ToString() ?? string.Empty)">@(contributor.Role.HasValue ? _localizer[contributor.Role.Value.ToString()].Value : "-")</span>
                                    </label>
                                    <div class="enlightenment-dropdown">
                                        <div class="enlightenment-option" data-value="">-</div>
                                        @foreach (string role in Enum.GetNames<MediaContributorRole>())
                                        {
                                            <div class="enlightenment-option" data-value="@role">@_localizer[role].Value</div>
                                        }
                                    </div>
                                </div>
                            </td>
                            <td><img src="~/images/ui/delete.svg" alt="@_localizer["Remove"]" title="@_localizer["Remove"]" class="remove-form-table-row-icon" /></td>
                        </tr>
                        contributorIndex++;
                    }
                </tbody>
            </table>
            <button id="btn-add-contributor" type="button" class="confirm-button">@_localizer["AddContributor"]</button>
            <small class="form-label text-disabled form-description">@_localizer["ContributorsDescription"]</small>
        </div>

        <!-- Ratings. -->
        <h3 class="text-light-two">@_localizer["Ratings"]</h3>
        <!-- Ratings table. -->
        <div class="form-row">
            <table class="w-100 form-table">
                <thead>
                    <tr>
                        <th>@_localizer["RatingValue"]</th>
                        <th>@_localizer["RatingMaxValue"]</th>
                        <th>@_localizer["RatingSource"]</th>
                        <th>@_localizer["RatingVoteCount"]</th>
                        <th class="w-40px"></th>
                    </tr>
                </thead>
                <tbody id="ratings-body">
                    @{ int ratingIndex = 0; }
                    @foreach (var rating in ratings)
                    {
                        <tr class="rating-row">
                            <td><input type="number" step="any" min="0" class="enlightenment-input rating-value" value="@(rating.Value?.ToString(CultureInfo.InvariantCulture) ?? string.Empty)" /></td>
                            <td><input type="number" step="any" min="0" class="enlightenment-input rating-max-value" value="@(rating.MaxValue?.ToString(CultureInfo.InvariantCulture) ?? string.Empty)" /></td>
                            <td>
                                <div class="enlightenment-combobox inline-block w-100 rating-source-combobox">
                                    <div class="shine-effect" style="top: 1px;"></div>
                                    <input type="checkbox" class="enlightenment-toggle-checkbox" id="rating-source-toggle-@ratingIndex" />
                                    <label class="enlightenment-toggle" for="rating-source-toggle-@ratingIndex">
                                        <span class="enlightenment-selected-text" data-value="@(rating.Source?.ToString() ?? string.Empty)">@(rating.Source.HasValue ? _localizer[rating.Source.Value.ToString()].Value : "-")</span>
                                    </label>
                                    <div class="enlightenment-dropdown">
                                        <div class="enlightenment-option" data-value="">-</div>
                                        @foreach (string source in Enum.GetNames<AudioRatingSource>())
                                        {
                                            <div class="enlightenment-option" data-value="@source">@_localizer[source].Value</div>
                                        }
                                    </div>
                                </div>
                            </td>
                            <td><input type="number" min="0" class="enlightenment-input rating-vote-count" value="@(rating.VoteCount?.ToString(CultureInfo.InvariantCulture) ?? string.Empty)" /></td>
                            <td><img src="~/images/ui/delete.svg" alt="@_localizer["Remove"]" title="@_localizer["Remove"]" class="remove-form-table-row-icon" /></td>
                        </tr>
                        ratingIndex++;
                    }
                </tbody>
            </table>
            <button id="btn-add-rating" type="button" class="confirm-button">@_localizer["AddRating"]</button>
            <small class="form-label text-disabled form-description">@_localizer["RatingsDescription"]</small>
        </div>

        <!-- Genres. -->
        <h3 class="text-light-two">@_localizer["Genres"]</h3>
        <!-- Genres table. -->
        <div class="form-row">
            <table class="w-100 form-table">
                <thead>
                    <tr>
                        <th>@_localizer["Genre"]</th>
                        <th class="w-40px"></th>
                    </tr>
                </thead>
                <tbody id="genres-body">
                    @foreach (var genre in genres)
                    {
                        <tr class="genre-row">
                            <td><input type="text" class="enlightenment-input genre-name w-100" value="@(genre.Name)" /></td>
                            <td><img src="~/images/ui/delete.svg" alt="@_localizer["Remove"]" title="@_localizer["Remove"]" class="remove-form-table-row-icon" /></td>
                        </tr>
                    }
                </tbody>
            </table>
            <button id="btn-add-genre" type="button" class="confirm-button">@_localizer["AddGenre"]</button>
            <small class="form-label text-disabled form-description">@_localizer["GenresDescription"]</small>
        </div>

        <!-- Tags. -->
        <h3 class="text-light-two">@_localizer["Tags"]</h3>
        <!-- Tags table. -->
        <div class="form-row">
            <table class="w-100 form-table">
                <thead>
                    <tr>
                        <th>@_localizer["Tag"]</th>
                        <th class="w-40px"></th>
                    </tr>
                </thead>
                <tbody id="tags-body">
                    @foreach (var tag in tags)
                    {
                        <tr class="tag-row">
                            <td><input type="text" class="enlightenment-input tag-name w-100" value="@(tag.Name)" /></td>
                            <td><img src="~/images/ui/delete.svg" alt="@_localizer["Remove"]" title="@_localizer["Remove"]" class="remove-form-table-row-icon" /></td>
                        </tr>
                    }
                </tbody>
            </table>
            <button id="btn-add-tag" type="button" class="confirm-button">@_localizer["AddTag"]</button>
            <small class="form-label text-disabled form-description">@_localizer["TagsDescription"]</small>
        </div>

        <!-- Aliases. -->
        <h3 class="text-light-two">@_localizer["Aliases"]</h3>
        <!-- Aliases table. -->
        <div class="form-row">
            <table class="w-100 form-table">
                <thead>
                    <tr>
                        <th>@_localizer["AliasName"]</th>
                        <th>@_localizer["AliasSortName"]</th>
                        <th>@_localizer["AliasType"]</th>
                        <th>@_localizer["AliasLocale"]</th>
                        <th>@_localizer["AliasIsPrimary"]</th>
                        <th>@_localizer["AliasBeginDate"]</th>
                        <th>@_localizer["AliasEndDate"]</th>
                        <th>@_localizer["AliasIsEnded"]</th>
                        <th class="w-40px"></th>
                    </tr>
                </thead>
                <tbody id="aliases-body">
                    @foreach (var alias in aliases)
                    {
                        <tr class="alias-row">
                            <td><input type="text" class="enlightenment-input alias-name" value="@(alias.Name ?? string.Empty)" /></td>
                            <td><input type="text" class="enlightenment-input alias-sort-name" value="@(alias.SortName ?? string.Empty)" /></td>
                            <td><input type="text" class="enlightenment-input alias-type" value="@(alias.Type ?? string.Empty)" /></td>
                            <td><input type="text" class="enlightenment-input alias-locale" value="@(alias.Locale ?? string.Empty)" /></td>
                            <td><label class="enlightenment-checkbox-label"><input type="checkbox" class="enlightenment-checkbox-hidden alias-is-primary" @(alias.IsPrimary ? "checked" : "") /><span class="enlightenment-checkbox"></span></label></td>
                            <td><input type="date" class="enlightenment-input alias-begin-date" value="@(alias.BeginDate?.ToString("yyyy-MM-dd") ?? string.Empty)" /></td>
                            <td><input type="date" class="enlightenment-input alias-end-date" value="@(alias.EndDate?.ToString("yyyy-MM-dd") ?? string.Empty)" /></td>
                            <td><label class="enlightenment-checkbox-label"><input type="checkbox" class="enlightenment-checkbox-hidden alias-is-ended" @(alias.IsEnded ? "checked" : "") /><span class="enlightenment-checkbox"></span></label></td>
                            <td><img src="~/images/ui/delete.svg" alt="@_localizer["Remove"]" title="@_localizer["Remove"]" class="remove-form-table-row-icon" /></td>
                        </tr>
                    }
                </tbody>
            </table>
            <button id="btn-add-alias" type="button" class="confirm-button">@_localizer["AddAlias"]</button>
            <small class="form-label text-disabled form-description">@_localizer["AliasesDescription"]</small>
        </div>

        <!-- Areas. -->
        <h3 class="text-light-two">@_localizer["Areas"]</h3>
        <!-- Area. -->
        <h4 class="text-light-two">@_localizer["Area"]</h4>
        <!-- Name. -->
        <div class="form-row">
            <div class="form-label"><label for="artist-area-name-input">@_localizer["AreaName"]</label>:</div>
            <div class="form-field"><input id="artist-area-name-input" type="text" class="enlightenment-input" value="@(area?.Name ?? string.Empty)" /></div>
            <small class="form-label text-disabled form-description">@_localizer["AreaNameDescription"]</small>
        </div>
        <!-- Sort name. -->
        <div class="form-row">
            <div class="form-label"><label for="artist-area-sort-name-input">@_localizer["AreaSortName"]</label>:</div>
            <div class="form-field"><input id="artist-area-sort-name-input" type="text" class="enlightenment-input" value="@(area?.SortName ?? string.Empty)" /></div>
            <small class="form-label text-disabled form-description">@_localizer["AreaSortNameDescription"]</small>
        </div>
        <!-- Disambiguation. -->
        <div class="form-row">
            <div class="form-label"><label for="artist-area-disambiguation-input">@_localizer["AreaDisambiguation"]</label>:</div>
            <div class="form-field"><input id="artist-area-disambiguation-input" type="text" class="enlightenment-input" value="@(area?.Disambiguation ?? string.Empty)" /></div>
            <small class="form-label text-disabled form-description">@_localizer["AreaDisambiguationDescription"]</small>
        </div>
        <!-- Type. -->
        <div class="form-row">
            <div class="form-label"><label for="artist-area-type-input">@_localizer["AreaType"]</label>:</div>
            <div class="form-field"><input id="artist-area-type-input" type="text" class="enlightenment-input" value="@(area?.Type ?? string.Empty)" /></div>
            <small class="form-label text-disabled form-description">@_localizer["AreaTypeDescription"]</small>
        </div>
        <!-- ISO 3166 code. -->
        <div class="form-row">
