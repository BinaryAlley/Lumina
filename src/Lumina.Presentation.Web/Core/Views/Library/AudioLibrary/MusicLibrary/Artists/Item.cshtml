                <div class="form-row mt-10">
                    <button id="btn-save-artist" type="button" class="confirm-button w-100px">@_localizer["Save"]</button>
                    <button id="btn-delete-artist" type="button" class="abort-button w-100px">@_localizer["DeleteArtist"]</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- The "text/plain" type is a design choice, not a mistake: it keeps the browser from executing this view script during HTML parsing, before site.js defines the API helpers it calls (callApiGetAsync, callApiPostAsync, ...). site.js (which loads deferred) executes these scripts once it is loaded, both on the initial page load and during AJAX navigation. -->
    <script type="text/plain" data-form="@scriptId">
        // Create cleanup registry for this view.
        const cleanupFunctions = [];
        let isInitialized = false;
        let generatedId = 1000;

        const artistId = '@artistId';
        const libraryId = '@libraryId';
        const artistsIndexUrl = '@_urlService.GetAbsoluteUrl(WebRoutes.Music.ARTISTS_INDEX)';
        const saveUrl = '@_urlService.GetAbsoluteUrl(WebRoutes.Music.SAVE_ARTIST, new { artistId = default(Guid) })'.replace('/@(default(Guid))', `/${artistId}`);
        const deleteUrl = '@_urlService.GetAbsoluteUrl(WebRoutes.Music.DELETE_ARTIST, new { artistId = default(Guid) })'.replace('/@(default(Guid))', `/${artistId}`);
        const albumsUrlTemplate = '@_urlService.GetAbsoluteUrl(WebRoutes.Music.GET_ARTIST_ALBUMS, new { artistId = default(Guid) })';
        const albumUrlTemplate = '@_urlService.GetAbsoluteUrl(WebRoutes.Music.ALBUM, new { artistId = default(Guid), albumId = default(Guid) })';
        const deleteAlbumUrlTemplate = '@_urlService.GetAbsoluteUrl(WebRoutes.Music.DELETE_ALBUM, new { artistId = default(Guid), albumId = default(Guid) })';
        const coverUrl = '@_urlService.GetAbsoluteUrl(WebRoutes.Music.UPDATE_ARTIST_COVER, new { artistId = default(Guid) })'.replace('/@(default(Guid))', `/${artistId}`) + `?libraryId=${libraryId}`;
        // The albums of the artist, mapped to the update request shape, so that saving the artist never drops them.
        const currentAlbums = @Html.Raw(albumsBaselineJson);

        // The element references are captured once, so that the cleanup can unbind their listeners even after the AJAX navigator has swapped the content out of the document.
        const btnBackToArtists = document.getElementById('btn-back-to-artists');
        const btnSaveArtist = document.getElementById('btn-save-artist');
        const btnDeleteArtist = document.getElementById('btn-delete-artist');
        const btnPlayArtist = document.getElementById('btn-play-artist');
        const btnAddAlias = document.getElementById('btn-add-alias');
        const btnAddIpi = document.getElementById('btn-add-ipi');
        const btnAddIsni = document.getElementById('btn-add-isni');
        const btnAddGenre = document.getElementById('btn-add-genre');
        const btnAddTag = document.getElementById('btn-add-tag');
        const btnAddContributor = document.getElementById('btn-add-contributor');
        const btnAddRating = document.getElementById('btn-add-rating');
        const albumsContainer = document.getElementById('albums-container');
        const noAlbumsMessage = document.getElementById('no-albums');
        const aliasesBody = document.getElementById('aliases-body');
        const ipisBody = document.getElementById('ipis-body');
        const isnisBody = document.getElementById('isnis-body');
        const genresBody = document.getElementById('genres-body');
        const tagsBody = document.getElementById('tags-body');
        const contributorsBody = document.getElementById('contributors-body');
        const ratingsBody = document.getElementById('ratings-body');
        const coverImage = document.getElementById('artist-cover-image');
        const coverPathLabel = document.getElementById('artist-cover-path');
        const coverInput = document.getElementById('artist-cover-input');
        const btnChangeCover = document.getElementById('btn-change-cover');

        const jsLocalizedStrings = {
            artistSaved: @Json.Serialize(_localizer["ArtistSaved"].Value),
            saveFailed: @Json.Serialize(_localizer["SaveFailed"].Value),
            artistDeleted: @Json.Serialize(_localizer["ArtistDeleted"].Value),
            albumDeleted: @Json.Serialize(_localizer["AlbumDeleted"].Value),
            deleteConfirm: @Json.Serialize(_localizer["DeleteConfirm"].Value),
            deleteFailed: @Json.Serialize(_localizer["DeleteFailed"].Value),
            noAlbums: @Json.Serialize(_localizer["NoAlbums"].Value),
            noCover: @Json.Serialize(_localizer["NoCover"].Value),
            coverSaved: @Json.Serialize(_localizer["CoverSaved"].Value),
            coverUploadFailed: @Json.Serialize(_localizer["CoverUploadFailed"].Value),
            play: @Json.Serialize(_localizer["Play"].Value),
            shuffle: @Json.Serialize(_localizer["Shuffle"].Value),
            remove: @Json.Serialize(_localizer["Remove"].Value)
        };

        // Reads the trimmed value of the element with the provided id.
        function readValue(id) {
            const element = document.getElementById(id);
            return element ? element.value.trim() : '';
        }

        // Reads the value of the enlightenment combobox with the provided id.
        function readComboboxValue(id) {
            const element = document.querySelector(`#${id} .enlightenment-selected-text`);
            return element ? (element.getAttribute('data-value') || '') : '';
        }

        // Reads the value of the enlightenment combobox inside the provided row, selected by its class.
        function readRowComboboxValue(row, className) {
            const element = row.querySelector(className + ' .enlightenment-selected-text');
            return element ? (element.getAttribute('data-value') || '') : '';
        }

        // Reads an optional number from a field, returning null when the field is empty or not a number.
        function readNumber(id) {
            const value = readValue(id);
            if (value === '')
                return null;
            const parsed = Number(value);
            return Number.isNaN(parsed) ? null : parsed;
        }

        // Reads an optional Guid from a field, returning null when the field is empty or not a valid Guid.
        function readGuid(id) {
            const value = readValue(id);
            if (!/^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$/.test(value))
                return null;
            return value;
        }

        // Reads the checked state of a checkbox element with the provided id.
        function readCheckbox(id) {
            const element = document.getElementById(id);
            return element ? element.checked === true : false;
        }

        // Parses a decimal value, returning null when the value is empty or not a number.
        function parseOptionalDecimal(value) {
            if (value.trim() === '')
                return null;
            const parsed = Number(value);
            return Number.isNaN(parsed) ? null : parsed;
        }

        // Parses an integer value, returning null when the value is empty or not a number.
        function parseIntOrNull(value) {
            if (value.trim() === '')
                return null;
            const parsed = parseInt(value, 10);
            return Number.isNaN(parsed) ? null : parsed;
        }

        // Builds the metadata object of the artist, matching the artist metadata of the API.
        function buildArtistMetadata() {
            return {
                Name: readValue('artist-name-input'),
                SortName: readValue('artist-sort-name-input') || null,
                Disambiguation: readValue('artist-disambiguation-input') || null,
                Type: readComboboxValue('artist-type-combobox') || null,
                Gender: readComboboxValue('artist-gender-combobox') || null,
                Country: readValue('artist-country-input') || null,
                Area: buildArea('artist-area'),
                BeginArea: buildArea('artist-begin-area'),
                EndArea: buildArea('artist-end-area'),
                LifeSpanBegin: readValue('artist-lifespan-begin-input') || null,
                LifeSpanEnd: readValue('artist-lifespan-end-input') || null,
                IsEnded: readCheckbox('artist-is-ended-input'),
                Genres: buildNameList(genresBody, '.genre-row', '.genre-name'),
                Tags: buildNameList(tagsBody, '.tag-row', '.tag-name'),
                Aliases: Array.from(aliasesBody.querySelectorAll('.alias-row')).map(row => ({
                    Name: row.querySelector('.alias-name').value.trim() || null,
                    SortName: row.querySelector('.alias-sort-name').value.trim() || null,
                    Type: row.querySelector('.alias-type').value.trim() || null,
                    Locale: row.querySelector('.alias-locale').value.trim() || null,
                    IsPrimary: row.querySelector('.alias-is-primary').checked,
                    BeginDate: row.querySelector('.alias-begin-date').value || null,
                    EndDate: row.querySelector('.alias-end-date').value || null,
                    IsEnded: row.querySelector('.alias-is-ended').checked
                }))
            };
        }

        // Builds the area object of an area group, or null when no field of the group carries a value.
        function buildArea(prefix) {
            const name = readValue(`${prefix}-name-input`);
            const sortName = readValue(`${prefix}-sort-name-input`);
            const disambiguation = readValue(`${prefix}-disambiguation-input`);
            const type = readValue(`${prefix}-type-input`);
            const isoCode = readValue(`${prefix}-iso3166-code-input`);
            const musicBrainzId = readGuid(`${prefix}-musicbrainz-id-input`);
            if (name === '' && sortName === '' && disambiguation === '' && type === '' && isoCode === '' && musicBrainzId === null)
                return null;
            return {
                MusicBrainzAreaId: musicBrainzId,
                Name: name || null,
                SortName: sortName || null,
                Disambiguation: disambiguation || null,
                Type: type || null,
                Iso3166Code: isoCode || null
            };
        }

        // Builds the list of media contributor references from the contributor rows.
        function buildContributors() {
            return Array.from(contributorsBody.querySelectorAll('.contributor-row')).map(row => ({
                ContributorId: row.querySelector('.contributor-id').value.trim() || '00000000-0000-0000-0000-000000000000',
                Role: readRowComboboxValue(row, '.contributor-role-combobox') || null
            }));
        }

        // Builds the list of ratings from the rating rows.
        function buildRatings() {
            return Array.from(ratingsBody.querySelectorAll('.rating-row')).map(row => ({
                Value: parseOptionalDecimal(row.querySelector('.rating-value').value),
                MaxValue: parseOptionalDecimal(row.querySelector('.rating-max-value').value),
                Source: readRowComboboxValue(row, '.rating-source-combobox') || null,
                VoteCount: parseIntOrNull(row.querySelector('.rating-vote-count').value)
            }));
        }

        // Builds a list of name valued entries from the rows of a table, skipping the rows whose name is empty.
        function buildNameList(body, rowSelector, inputSelector) {
            return Array.from(body.querySelectorAll(rowSelector))
                .map(row => row.querySelector(inputSelector).value.trim())
                .filter(name => name !== '')
                .map(name => ({ Name: name }));
        }

        // Builds a list of plain string entries from the rows of a table, skipping the rows whose value is empty.
        function buildStringList(body, rowSelector, inputSelector) {
            return Array.from(body.querySelectorAll(rowSelector))
                .map(row => row.querySelector(inputSelector).value.trim())
                .filter(value => value !== '');
        }

        // Builds the payload of the edited artist, matching the update request of the API, round-tripping the albums unchanged.
        function buildPayload() {
            return {
                Metadata: buildArtistMetadata(),
                Website: readValue('artist-website-input') || null,
                MusicBrainzArtistId: readGuid('artist-musicbrainz-id-input'),
                Ipis: buildStringList(ipisBody, '.ipi-row', '.ipi-value'),
                Isnis: buildStringList(isnisBody, '.isni-row', '.isni-value'),
                Contributors: buildContributors(),
                Ratings: buildRatings(),
                Albums: currentAlbums
            };
        }

        // Builds the HTML of an enlightenment combobox of a row, with the provided options and an optional wrapper class.
        function buildRowCombobox(options, selectedValue, wrapperClass) {
            const id = `row-combobox-${generatedId++}`;
            const optionHtml = options.map(option =>
                `<div class="enlightenment-option" data-value="${option.value}">${option.label}</div>`).join('');
            return `
                <div class="enlightenment-combobox inline-block w-100 ${wrapperClass || ''}">
                    <div class="shine-effect" style="top: 1px;"></div>
                    <input type="checkbox" class="enlightenment-toggle-checkbox" id="${id}" />
                    <label class="enlightenment-toggle" for="${id}">
                        <span class="enlightenment-selected-text" data-value="${selectedValue || ''}">${selectedLabel(options, selectedValue)}</span>
                    </label>
                    <div class="enlightenment-dropdown">
                        <div class="enlightenment-option" data-value="">-</div>
                        ${optionHtml}
                    </div>
                </div>`;
        }

        // Returns the display text of a selected combobox value, using the default dash when nothing is selected.
        function selectedLabel(options, value) {
            if (!value)
                return '-';
            const option = options.find(item => item.value === value);
            return option ? option.label : value;
        }

        const contributorRoleOptions = @Html.Raw(contributorRoleOptionsJson);
        const ratingSourceOptions = @Html.Raw(ratingSourceOptionsJson);

        // Adds a blank alias row.
        function addAliasRow() {
            aliasesBody.insertAdjacentHTML('beforeend', `
                <tr class="alias-row">
                    <td><input type="text" class="enlightenment-input alias-name" /></td>
                    <td><input type="text" class="enlightenment-input alias-sort-name" /></td>
                    <td><input type="text" class="enlightenment-input alias-type" /></td>
                    <td><input type="text" class="enlightenment-input alias-locale" /></td>
                    <td><label class="enlightenment-checkbox-label"><input type="checkbox" class="enlightenment-checkbox-hidden alias-is-primary" /><span class="enlightenment-checkbox"></span></label></td>
                    <td><input type="date" class="enlightenment-input alias-begin-date" /></td>
                    <td><input type="date" class="enlightenment-input alias-end-date" /></td>
                    <td><label class="enlightenment-checkbox-label"><input type="checkbox" class="enlightenment-checkbox-hidden alias-is-ended" /><span class="enlightenment-checkbox"></span></label></td>
                    <td><img src="/images/ui/delete.svg" alt="${jsLocalizedStrings.remove}" title="${jsLocalizedStrings.remove}" class="remove-form-table-row-icon" /></td>
                </tr>`);
        }

        // Adds a blank IPI row.
        function addIpiRow() {
            ipisBody.insertAdjacentHTML('beforeend', `
                <tr class="ipi-row">
                    <td><input type="text" class="enlightenment-input ipi-value w-100" /></td>
                    <td><img src="/images/ui/delete.svg" alt="${jsLocalizedStrings.remove}" title="${jsLocalizedStrings.remove}" class="remove-form-table-row-icon" /></td>
                </tr>`);
        }

        // Adds a blank ISNI row.
        function addIsniRow() {
            isnisBody.insertAdjacentHTML('beforeend', `
                <tr class="isni-row">
                    <td><input type="text" class="enlightenment-input isni-value w-100" /></td>
                    <td><img src="/images/ui/delete.svg" alt="${jsLocalizedStrings.remove}" title="${jsLocalizedStrings.remove}" class="remove-form-table-row-icon" /></td>
                </tr>`);
        }

        // Adds a blank genre row.
        function addGenreRow() {
            genresBody.insertAdjacentHTML('beforeend', `
                <tr class="genre-row">
                    <td><input type="text" class="enlightenment-input genre-name w-100" /></td>
                    <td><img src="/images/ui/delete.svg" alt="${jsLocalizedStrings.remove}" title="${jsLocalizedStrings.remove}" class="remove-form-table-row-icon" /></td>
                </tr>`);
        }

        // Adds a blank tag row.
        function addTagRow() {
            tagsBody.insertAdjacentHTML('beforeend', `
                <tr class="tag-row">
                    <td><input type="text" class="enlightenment-input tag-name w-100" /></td>
                    <td><img src="/images/ui/delete.svg" alt="${jsLocalizedStrings.remove}" title="${jsLocalizedStrings.remove}" class="remove-form-table-row-icon" /></td>
                </tr>`);
        }

        // Adds a blank contributor row.
        function addContributorRow() {
            contributorsBody.insertAdjacentHTML('beforeend', `
                <tr class="contributor-row">
                    <td><input type="text" class="enlightenment-input contributor-id w-100" /></td>
                    <td>${buildRowCombobox(contributorRoleOptions, '', 'contributor-role-combobox')}</td>
                    <td><img src="/images/ui/delete.svg" alt="${jsLocalizedStrings.remove}" title="${jsLocalizedStrings.remove}" class="remove-form-table-row-icon" /></td>
                </tr>`);
        }
        // Adds a blank rating row.
        function addRatingRow() {
            ratingsBody.insertAdjacentHTML('beforeend', `
                <tr class="rating-row">
                    <td><input type="number" step="any" min="0" class="enlightenment-input rating-value" /></td>
                    <td><input type="number" step="any" min="0" class="enlightenment-input rating-max-value" /></td>
                    <td>${buildRowCombobox(ratingSourceOptions, '', 'rating-source-combobox')}</td>
                    <td><input type="number" min="0" class="enlightenment-input rating-vote-count" /></td>
                    <td><img src="/images/ui/delete.svg" alt="${jsLocalizedStrings.remove}" title="${jsLocalizedStrings.remove}" class="remove-form-table-row-icon" /></td>
                </tr>`);
        }

        // Removes the row of the clicked remove icon.
        function handleRowRemoval(event) {
            if (event.target.matches('.remove-form-table-row-icon'))
                event.target.closest('tr').remove();
        }

        // Builds the URL of the album details page of the provided album.
        function buildAlbumUrl(albumId) {
            return albumUrlTemplate.replace('/@(default(Guid))', `/${artistId}`).replace('/@(default(Guid))', `/${albumId}`) + `?libraryId=${libraryId}`;
        }

        // Builds the URL of the album deletion endpoint of the provided album.
        function buildDeleteAlbumUrl(albumId) {
            return deleteAlbumUrlTemplate.replace('/@(default(Guid))', `/${artistId}`).replace('/@(default(Guid))', `/${albumId}`) + `?libraryId=${libraryId}`;
        }

        // Writes the play descriptor of an album onto an album card menu action.
        function applyAlbumPlayDescriptor(trigger, album) {
            trigger.dataset.libraryId = libraryId;
            trigger.dataset.artistId = artistId;
            trigger.dataset.albumId = album.id;
            trigger.dataset.title = album.title || '';
            if (album.coverPath)
                trigger.dataset.coverArtPath = album.coverPath;
            else
                delete trigger.dataset.coverArtPath;
        }

        // Creates an action of the album card actions menu.
        function createAlbumMenuAction(label, className) {
            const action = document.createElement('a');
            action.setAttribute('role', 'menuitem');
            action.href = '#';
            action.className = className;
            action.textContent = label;
            return action;
        }

        // The localized labels of the release types, keyed by their canonical enum name.
        const releaseTypeLabels = {
            'Album': '@_localizer["Album"].Value',
            'Broadcast': '@_localizer["Broadcast"].Value',
            'Ep': '@_localizer["Ep"].Value',
            'Other': '@_localizer["Other"].Value',
            'Single': '@_localizer["Single"].Value',
            'AudioDrama': '@_localizer["AudioDrama"].Value',
            'AudioBook': '@_localizer["AudioBook"].Value',
            'Compilation': '@_localizer["Compilation"].Value',
            'DjMix': '@_localizer["DjMix"].Value',
            'Demo': '@_localizer["Demo"].Value',
            'FieldRecording': '@_localizer["FieldRecording"].Value',
            'Interview': '@_localizer["Interview"].Value',
            'Live': '@_localizer["Live"].Value',
            'Mixtape': '@_localizer["Mixtape"].Value',
            'Remix': '@_localizer["Remix"].Value',
            'Soundtrack': '@_localizer["Soundtrack"].Value',
            'SpokenWord': '@_localizer["SpokenWord"].Value'
        };
        // The order in which the release type groups are displayed, from the most common to the least common.
        const releaseTypeOrder = ['Album', 'Compilation', 'Ep', 'Live', 'Remix', 'Single', 'Soundtrack', 'Broadcast', 'AudioDrama', 'AudioBook', 'Demo', 'DjMix', 'FieldRecording', 'Interview', 'Mixtape', 'SpokenWord', 'Other'];

        // Loads and renders the releases of the artist, grouped by their release type.
        async function loadAlbumsAsync() {
            const url = albumsUrlTemplate.replace('/@(default(Guid))', `/${artistId}`) + `?libraryId=${libraryId}`;
            const response = await callApiGetAsync(url);
            renderReleases(response);
        }

        // Renders the releases of the artist, grouped by their primary release type, each group ordered by release year. A
        // failed request returns undefined, which is not an empty discography: it leaves the existing list and play state intact.
        function renderReleases(response) {
            if (!response || !Array.isArray(response.data))
                return;
            albumsContainer.querySelectorAll('.release-group').forEach(group => group.remove());
            const releases = response.data;
            noAlbumsMessage.classList.toggle('hidden', releases.length !== 0);
            // Only a successful empty list disables the play all trigger. The player can still build the queue itself when the release list could not be loaded.
            btnPlayArtist.disabled = releases.length === 0;

            // The releases are grouped by their first release type, falling back to "Other" when the type is not known.
            const groups = new Map();
            releases.forEach(release => {
                const type = release.releaseTypes && release.releaseTypes.length > 0 ? release.releaseTypes[0] : 'Other';
                if (!groups.has(type))
                    groups.set(type, []);
                groups.get(type).push(release);
            });

            releaseTypeOrder.forEach(type => {
                const items = groups.get(type);
                if (!items || items.length === 0)
                    return;
                items.sort((left, right) => (left.releaseYear ?? 0) - (right.releaseYear ?? 0));
                albumsContainer.appendChild(createReleaseGroup(type, items));
            });

            bindNavigationLinks();
        }

        // Creates a titled group of release cards, ordered by release year.
        function createReleaseGroup(type, releases) {
            const group = document.createElement('div');
            group.className = 'release-group';
            group.style.width = '100%';
            const heading = document.createElement('h3');
            heading.className = 'text-light-three';
            heading.style.fontSize = '1.5rem';
            heading.textContent = releaseTypeLabels[type] || type;
            group.appendChild(heading);
            const container = document.createElement('div');
            container.className = 'cards-container justify-start';
            releases.forEach(release => container.appendChild(createAlbumCard(release)));
            group.appendChild(container);
            return group;
        }

        // Creates a card for an album, that navigates to the album page when clicked, with a delete action.
        function createAlbumCard(album) {
            const card = document.createElement('div');
            card.className = 'media-card';
            card.dataset.albumId = album.id;

            const cardLink = document.createElement('a');
            cardLink.className = 'media-panel nav-link no-underline';
            cardLink.style.width = '200px';
            cardLink.style.height = 'auto';
            cardLink.href = buildAlbumUrl(album.id);

            // The cover is shown as a square, cropped from its center (never stretched), and the title and year are shown underneath it.
            const image = document.createElement('img');
            image.src = album.coverPath
                ? `${globalConfiguration.serverBasePath}${album.coverPath}`
                : `/images/ui/music-placeholder.svg`;
            image.alt = album.title;
            image.style.width = '200px';
            image.style.height = '200px';
            image.style.flexGrow = '0';
            image.style.objectFit = 'cover';
            image.style.objectPosition = 'center';
            cardLink.appendChild(image);

            // The title is kept on a single line, truncated with an ellipsis when it does not fit, so that all the cards share the same height.
            const titleSpan = document.createElement('span');
            titleSpan.className = 'text-light-two';
            titleSpan.style.display = 'block';
            titleSpan.style.width = '200px';
            titleSpan.style.boxSizing = 'border-box';
            titleSpan.style.height = 'auto';
            titleSpan.style.padding = '4px';
            titleSpan.style.textAlign = 'center';
            titleSpan.style.whiteSpace = 'nowrap';
            titleSpan.style.overflow = 'hidden';
            titleSpan.style.textOverflow = 'ellipsis';
            const title = document.createElement('strong');
            title.textContent = album.title;
            titleSpan.appendChild(title);
            cardLink.appendChild(titleSpan);

            // The release year is shown underneath the title, in a smaller, centered font.
            if (album.releaseYear) {
                const yearSpan = document.createElement('small');
                yearSpan.className = 'text-light-two';
                yearSpan.style.display = 'block';
                yearSpan.style.textAlign = 'center';
                yearSpan.style.fontSize = '0.75rem';
                yearSpan.style.paddingBottom = '4px';
                yearSpan.textContent = album.releaseYear;
                cardLink.appendChild(yearSpan);
            }

            const trigger = document.createElement('button');
            trigger.type = 'button';
            trigger.className = 'card-actions-trigger';
            trigger.setAttribute('aria-haspopup', 'menu');
            trigger.addEventListener('click', event => {
                event.preventDefault();
                event.stopImmediatePropagation();
                toggleCardMenu(card, resolveMenuAnchor(event));
            });

            const menu = document.createElement('nav');
            menu.className = 'card-actions-menu';
            menu.setAttribute('role', 'menu');

            const playAction = createAlbumMenuAction(jsLocalizedStrings.play, 'card-action-play');
            playAction.setAttribute('data-audio-player-play', '');
            applyAlbumPlayDescriptor(playAction, album);

            const shuffleAction = createAlbumMenuAction(jsLocalizedStrings.shuffle, 'card-action-shuffle');
            shuffleAction.setAttribute('data-audio-player-play-shuffled', '');
            shuffleAction.setAttribute('data-audio-player-shuffle-scope', 'release');
            applyAlbumPlayDescriptor(shuffleAction, album);

            const deleteAction = createAlbumMenuAction(jsLocalizedStrings.remove, 'card-action-delete');

            menu.appendChild(playAction);
            menu.appendChild(shuffleAction);
            menu.appendChild(deleteAction);

            menu.addEventListener('click', async event => {
                // Play and shuffle are handled by the global audio player delegation, so the menu only closes here.
                if (event.target.closest('.card-action-play, .card-action-shuffle')) {
                    closeCardMenus();
                    return;
                }
                const deleteItem = event.target.closest('.card-action-delete');
                if (!deleteItem)
                    return;
                event.preventDefault();
                event.stopImmediatePropagation();
                closeCardMenus();
                await deleteAlbumAsync(card.dataset.albumId);
            });

            card.appendChild(cardLink);
            card.appendChild(trigger);
            card.appendChild(menu);

            card.addEventListener('contextmenu', event => {
                event.preventDefault();
                event.stopImmediatePropagation();
                toggleCardMenu(card, resolveMenuAnchor(event));
            });

            return card;
        }

        // Toggles the actions menu of the album card, opening it with its top left corner at the given viewport position.
        function toggleCardMenu(card, anchor) {
            const wasOpen = card.classList.contains('open');
            closeCardMenus();
            if (wasOpen)
                return;
            card.classList.add('open');
            const menu = card.querySelector('.card-actions-menu');
            if (menu) {
                menu.classList.add('open');
                positionActionsMenu(menu, anchor);
            }
        }

        // Resolves the viewport point where the card actions menu opens.
        function resolveMenuAnchor(event) {
            if (event.clientX !== 0 || event.clientY !== 0)
                return { x: event.clientX, y: event.clientY };
            const triggerRect = event.currentTarget.getBoundingClientRect();
            return { x: triggerRect.left, y: triggerRect.bottom };
        }

        // Places the card actions menu with its top left corner at the requested viewport point.
        function positionActionsMenu(menu, anchor) {
            const margin = 4;
            const maxLeft = Math.max(margin, window.innerWidth - menu.offsetWidth - margin);
            const maxTop = Math.max(margin, window.innerHeight - menu.offsetHeight - margin);
            menu.style.position = 'fixed';
            menu.style.left = `${Math.min(Math.max(margin, anchor.x), maxLeft)}px`;
            menu.style.top = `${Math.min(Math.max(margin, anchor.y), maxTop)}px`;
        }

        // Closes the actions menus of all the album cards.
        function closeCardMenus() {
            albumsContainer.querySelectorAll('.media-card.open').forEach(card => {
                card.classList.remove('open');
                const menu = card.querySelector('.card-actions-menu');
                if (menu)
                    menu.classList.remove('open');
            });
        }

        // Closes the actions menus when clicking or pressing a key outside them.
        function handleCardMenuDismiss(event) {
            if (event.type === 'keydown' && event.key !== 'Escape')
                return;
            if (event.type === 'click' && event.target.closest('.card-actions-menu, .card-actions-trigger'))
                return;
            closeCardMenus();
        }

        // Deletes an album after confirmation, then reloads the albums.
        async function deleteAlbumAsync(albumId) {
            if (await dialogService.show(jsLocalizedStrings.deleteConfirm, jsLocalizedDialogs.confirmation, DialogButtons.YES_NO, DialogIcon.QUESTION) !== DialogButton.YES)
                return;
            const success = await callApiDeleteAsync(buildDeleteAlbumUrl(albumId));
            if (success) {
                notificationService.show(jsLocalizedStrings.albumDeleted, NotificationType.SUCCESS);
                await loadAlbumsAsync();
            } else {
                notificationService.show(jsLocalizedStrings.deleteFailed, NotificationType.ERROR);
            }
        }

        // Sends the edited artist data to the server.
        async function handleSaveAsync() {
            const result = await callApiPutAsync(`${saveUrl}?libraryId=${encodeURIComponent(libraryId)}`, buildPayload());
            if (result && result.success === true) {
                notificationService.show(jsLocalizedStrings.artistSaved, NotificationType.SUCCESS);
            } else {
                notificationService.show(jsLocalizedStrings.saveFailed, NotificationType.ERROR);
            }
        }

        // Deletes the artist after confirmation, then returns to the artists browsing page.
        async function handleDeleteAsync() {
            if (await dialogService.show(jsLocalizedStrings.deleteConfirm, jsLocalizedDialogs.confirmation, DialogButtons.YES_NO, DialogIcon.QUESTION) !== DialogButton.YES)
                return;
            const success = await callApiDeleteAsync(`${deleteUrl}?libraryId=${encodeURIComponent(libraryId)}`);
            if (success) {
                notificationService.show(jsLocalizedStrings.artistDeleted, NotificationType.SUCCESS);
                await updateContentAsync(`${artistsIndexUrl}?libraryId=${encodeURIComponent(libraryId)}`, true);
            } else {
                notificationService.show(jsLocalizedStrings.deleteFailed, NotificationType.ERROR);
            }
        }

        // Navigates back to the artists browsing page.
        async function handleBackToArtistsAsync() {
            await updateContentAsync(`${artistsIndexUrl}?libraryId=${encodeURIComponent(libraryId)}`, true);
        }

        // Opens the file picker that chooses the new cover image.
        function handleChangeCoverClick() {
            if (coverInput)
                coverInput.click();
        }

        // Uploads the selected cover image to the server.
        async function handleCoverChangeAsync() {
            const file = coverInput.files && coverInput.files[0];
            if (!file)
                return;
            const formData = new FormData();
            formData.append('cover', file);

            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
            const headers = { 'X-Requested-With': 'XMLHttpRequest' };
            if (token)
                headers['RequestVerificationToken'] = token;

            let response;
            try {
                response = await fetch(coverUrl, {
                    method: 'PUT',
                    headers: headers,
                    body: formData
                });
            } catch (error) {
                console.error('Error:', error);
                notificationService.show(jsLocalizedStrings.coverUploadFailed, NotificationType.ERROR);
                return;
            }
            if (response.redirected) {
                window.location.href = response.url;
                return;
            }
            if (!response.ok) {
                notificationService.show(jsLocalizedStrings.coverUploadFailed, NotificationType.ERROR);
                return;
            }
            const jsonResponse = await response.json();
            if (jsonResponse.success === true) {
                // Show the uploaded cover immediately, so that the user sees the change without reloading.
                const reader = new FileReader();
                reader.onload = function(event) {
                    coverImage.src = event.target.result;
                    const storedPath = jsonResponse.data || '';
                    coverImage.dataset.coverPath = storedPath;
                    coverPathLabel.textContent = storedPath ? storedPath : jsLocalizedStrings.noCover;
                    coverPathLabel.title = storedPath;
                    // The player shows the cover the page displays, so the uploaded cover is handed to the play trigger too.
                    if (storedPath)
                        btnPlayArtist.dataset.coverArtPath = storedPath;
                    else
                        delete btnPlayArtist.dataset.coverArtPath;
                };
                reader.readAsDataURL(file);
                notificationService.show(jsLocalizedStrings.coverSaved, NotificationType.SUCCESS);
            } else {
                notificationService.show(jsLocalizedStrings.coverUploadFailed, NotificationType.ERROR);
            }
        }

        // Shows the cover image of the artist, or a placeholder when the artist has no cover.
        function showCover() {
            const coverPath = coverImage.dataset.coverPath || '';
            coverImage.src = coverPath
                ? `${globalConfiguration.serverBasePath}${coverPath}`
                : `/images/ui/music-placeholder.svg`;
            coverPathLabel.textContent = coverPath ? coverPath : jsLocalizedStrings.noCover;
            coverPathLabel.title = coverPath || '';
        }

        // Add listeners.
        btnSaveArtist.addEventListener('click', handleSaveAsync);
        btnDeleteArtist.addEventListener('click', handleDeleteAsync);
        btnBackToArtists.addEventListener('click', handleBackToArtistsAsync);
        btnAddAlias.addEventListener('click', addAliasRow);
        btnAddIpi.addEventListener('click', addIpiRow);
        btnAddIsni.addEventListener('click', addIsniRow);
        btnAddGenre.addEventListener('click', addGenreRow);
        btnAddTag.addEventListener('click', addTagRow);
        btnAddContributor.addEventListener('click', addContributorRow);
        btnAddRating.addEventListener('click', addRatingRow);
        aliasesBody.addEventListener('click', handleRowRemoval);
        ipisBody.addEventListener('click', handleRowRemoval);
        isnisBody.addEventListener('click', handleRowRemoval);
        genresBody.addEventListener('click', handleRowRemoval);
        tagsBody.addEventListener('click', handleRowRemoval);
        contributorsBody.addEventListener('click', handleRowRemoval);
        ratingsBody.addEventListener('click', handleRowRemoval);
        document.addEventListener('click', handleCardMenuDismiss);
        document.addEventListener('keydown', handleCardMenuDismiss);
        btnChangeCover.addEventListener('click', handleChangeCoverClick);
        coverInput.addEventListener('change', handleCoverChangeAsync);
        document.addEventListener('DOMContentLoaded', InitializeAsync);

        // Register cleanup for these listeners.
        cleanupFunctions.push(() => {
            btnSaveArtist.removeEventListener('click', handleSaveAsync);
            btnDeleteArtist.removeEventListener('click', handleDeleteAsync);
            btnBackToArtists.removeEventListener('click', handleBackToArtistsAsync);
            btnAddAlias.removeEventListener('click', addAliasRow);
            btnAddIpi.removeEventListener('click', addIpiRow);
            btnAddIsni.removeEventListener('click', addIsniRow);
            btnAddGenre.removeEventListener('click', addGenreRow);
            btnAddTag.removeEventListener('click', addTagRow);
            btnAddContributor.removeEventListener('click', addContributorRow);
            btnAddRating.removeEventListener('click', addRatingRow);
            aliasesBody.removeEventListener('click', handleRowRemoval);
            ipisBody.removeEventListener('click', handleRowRemoval);
            isnisBody.removeEventListener('click', handleRowRemoval);
            genresBody.removeEventListener('click', handleRowRemoval);
            tagsBody.removeEventListener('click', handleRowRemoval);
            contributorsBody.removeEventListener('click', handleRowRemoval);
            ratingsBody.removeEventListener('click', handleRowRemoval);
            document.removeEventListener('click', handleCardMenuDismiss);
            document.removeEventListener('keydown', handleCardMenuDismiss);
            btnChangeCover.removeEventListener('click', handleChangeCoverClick);
            coverInput.removeEventListener('change', handleCoverChangeAsync);
            document.removeEventListener('DOMContentLoaded', InitializeAsync);
        });

        // Initializes the page, showing the cover of the artist and loading the albums of the artist.
        async function InitializeAsync() {
            if (isInitialized)
                return;
            isInitialized = true;
            showCover();
            await loadAlbumsAsync();
        }

        // Store all cleanups for this view on window object using the scriptId.
        window.viewCleanups = window.viewCleanups || {};
        window.viewCleanups['@scriptId'] = () => {
            cleanupFunctions.forEach(cleanup => cleanup());
            console.log(`Unloaded @scriptId`);
        };
        console.log(`Loaded @scriptId`);
    </script>
}
