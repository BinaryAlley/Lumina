@*
/tools/settings
*@

@using Lumina.Presentation.Web.Common.DTO.UsersManagement
@using Lumina.Presentation.Web.Common.Services
@using Microsoft.AspNetCore.Mvc.Localization

@{
    // Generate a unique id for the scripts section of this view, so it can be dynamically loaded/unloaded by the global AJAX navigator handler.
    var scriptId = ScriptIdentifierHelper.GenerateScriptId();
}

@inject IUrlService _urlService
@inject IViewLocalizer _localizer

@model UserSettingsDto

<div style="display: grid; grid-template-rows: auto 1fr;"><!--Container with two rows, one fixed, one filling remaining space.-->
    <div style="min-height: 1rem;"></div><!--The first row is a dummy row for "margin", because setting a margin on the next row would offset the parent's position.-->
    <div class="enlightenment-panel shadow-effect mx-auto panel w-50 mb-10" style="min-width: 320px;">
        <div class="shine-effect"></div>
        <form method="post" id="user-settings-form" class="inline">
            @Html.AntiForgeryToken()
            <div class="form-row">
                <h1 class="text-light-two w-100 text-center pt-0 pb-0 engraved-title">
                    @_localizer["Settings"]
                </h1>
            </div>
            <div class="form-container">
                <!-- Pagination. -->
                <div class="form-row">
                    <div class="form-label">
                        <label asp-for="IsPaginationEnabled">@_localizer["EnablePagination"]</label>:
                    </div>
                    <div class="form-field">
                        <label class="enlightenment-checkbox-label">
                            <input type="checkbox" asp-for="IsPaginationEnabled" class="enlightenment-checkbox-hidden" />
                            <span class="enlightenment-checkbox"></span>
                        </label>
                    </div>
                    <small class="form-label text-disabled form-description">@_localizer["DescriptionEnablePagination"]</small>
                </div>
                <!-- Items per page. -->
                <div class="form-row">
                    <div class="form-label">
                        <label asp-for="ItemsPerPage">@_localizer["ItemsPerPage"]</label>
                        <span class="mandatory-field">*</span>:
                    </div>
                    <div class="form-field">
                        <input asp-for="ItemsPerPage" min="1" step="1" class="enlightenment-input" />
                    </div>
                    <small class="form-label text-disabled form-description">@_localizer["DescriptionItemsPerPage"]</small>
                </div>
                <!-- Alpha picker -->
                <div class="form-row">
                    <div class="form-label">
                        <label asp-for="ShouldIgnoreThePrefixForAlphaPicker">@_localizer["ShouldIgnoreThePrefixForAlphaPicker"]</label>:
                    </div>
                    <div class="form-field">
                        <label class="enlightenment-checkbox-label">
                            <input type="checkbox" asp-for="ShouldIgnoreThePrefixForAlphaPicker" class="enlightenment-checkbox-hidden" />
                            <span class="enlightenment-checkbox"></span>
                        </label>
                    </div>
                    <small class="form-label text-disabled form-description">@_localizer["DescriptionShouldIgnoreThePrefixForAlphaPicker"]</small>
                </div>
                <!-- Theme caching. -->
                <div class="form-row">
                    <div class="form-label">
                        <label asp-for="IsThemeCachingEnabled">@_localizer["EnableThemeCaching"]</label>:
                    </div>
                    <div class="form-field">
                        <label class="enlightenment-checkbox-label">
                            <input type="checkbox" asp-for="IsThemeCachingEnabled" class="enlightenment-checkbox-hidden" />
                            <span class="enlightenment-checkbox"></span>
                        </label>
                    </div>
                    <small class="form-label text-disabled form-description">@_localizer["DescriptionEnableThemeCaching"]</small>
                </div>
                <!-- Render PDFs as images. -->
                <div class="form-row">
                    <div class="form-label">
                        <label asp-for="ShouldRenderPdfAsImages">@_localizer["ShouldRenderPdfAsImages"]</label>:
                    </div>
                    <div class="form-field">
                        <label class="enlightenment-checkbox-label">
                            <input type="checkbox" asp-for="ShouldRenderPdfAsImages" class="enlightenment-checkbox-hidden" />
                            <span class="enlightenment-checkbox"></span>
                        </label>
                    </div>
                    <small class="form-label text-disabled form-description">@_localizer["DescriptionShouldRenderPdfAsImages"]</small>
                </div>
                <!-- Preserve book styles. -->
                <div class="form-row">
                    <div class="form-label">
                        <label asp-for="ShouldPreserveBookStyles">@_localizer["ShouldPreserveBookStyles"]</label>:
                    </div>
                    <div class="form-field">
                        <label class="enlightenment-checkbox-label">
                            <input type="checkbox" asp-for="ShouldPreserveBookStyles" class="enlightenment-checkbox-hidden" />
                            <span class="enlightenment-checkbox"></span>
                        </label>
                    </div>
                    <small class="form-label text-disabled form-description">@_localizer["DescriptionShouldPreserveBookStyles"]</small>
                </div>
                <div class="form-row" style="justify-content: center;">
                    <button type="submit" class="confirm-button h-22px">@_localizer["Save"]</button>
                </div>
            </div>
        </form>
    </div>
</div>
@section Scripts {
    <!-- The "text/plain" type is a design choice, not a mistake: it keeps the browser from executing this view script during HTML parsing, before site.js defines the API helpers it calls (callApiGetAsync, callApiPostAsync, ...). site.js (which loads deferred) executes these scripts once it is loaded, both on the initial page load and during AJAX navigation. -->
    <script type="text/plain" data-form="@scriptId">
        // Create cleanup registry for this view.
        const cleanupFunctions = [];
        let isInitialized = false;

        const form = document.getElementById('user-settings-form');
        const checkboxIsPaginationEnabled = document.getElementById('IsPaginationEnabled');
        const inputItemsPerPage = document.getElementById('ItemsPerPage');
        const checkboxShouldIgnoreThePrefixForAlphaPicker = document.getElementById('ShouldIgnoreThePrefixForAlphaPicker');
        const checkboxIsThemeCachingEnabled = document.getElementById('IsThemeCachingEnabled');
        const checkboxShouldRenderPdfAsImages = document.getElementById('ShouldRenderPdfAsImages');
        const checkboxShouldPreserveBookStyles = document.getElementById('ShouldPreserveBookStyles');
        let shouldAggregateMetadataWhenMissing = false;

        // Toggle the enabled state of the items per page input based on the pagination checkbox.
        function updateItemsPerPageEnabledState() {
            inputItemsPerPage.disabled = !checkboxIsPaginationEnabled.checked;
        }

        // Load the settings of the current user.
        async function loadUserSettingsAsync() {
            const data = await callApiGetAsync('@_urlService.GetAbsoluteUrl(WebRoutes.Settings.GET_USER_SETTINGS)');
            if (data) {
                checkboxIsPaginationEnabled.checked = data.isPaginationEnabled === true;
                inputItemsPerPage.value = data.itemsPerPage;
                checkboxShouldIgnoreThePrefixForAlphaPicker.checked = data.shouldIgnoreThePrefixForAlphaPicker === true;
                checkboxIsThemeCachingEnabled.checked = data.isThemeCachingEnabled === true;
                checkboxShouldRenderPdfAsImages.checked = data.shouldRenderPdfAsImages === true;
                checkboxShouldPreserveBookStyles.checked = data.shouldPreserveBookStyles === true;
                shouldAggregateMetadataWhenMissing = data.shouldAggregateMetadataWhenMissing === true;
                updateItemsPerPageEnabledState();
            }
        }

        // Save the settings of the current user.
        async function handleSaveUserSettingsAsync() {
            const formData = {
                IsPaginationEnabled: checkboxIsPaginationEnabled.checked,
                ItemsPerPage: Number(inputItemsPerPage.value),
                ShouldIgnoreThePrefixForAlphaPicker: checkboxShouldIgnoreThePrefixForAlphaPicker.checked,
                IsThemeCachingEnabled: checkboxIsThemeCachingEnabled.checked,
                ShouldAggregateMetadataWhenMissing: shouldAggregateMetadataWhenMissing,
                ShouldRenderPdfAsImages: checkboxShouldRenderPdfAsImages.checked,
                ShouldPreserveBookStyles: checkboxShouldPreserveBookStyles.checked
            };
            const data = await callApiPostAsync('@_urlService.GetAbsoluteUrl(WebRoutes.Settings.UPDATE_USER_SETTINGS)', formData);
            if (data && data.isUpdated === true)
                notificationService.show('@_localizer["SettingsSaved"]', NotificationType.SUCCESS);
        }

        // On form submit event.
        const handleSubmit = async function(e) {
            e.preventDefault();
            await handleSaveUserSettingsAsync();
        };

        // On pagination checkbox change, update the enabled state of the items per page input.
        const handlePaginationCheckboxChange = function() {
            updateItemsPerPageEnabledState();
        };

        // Add listeners.
        form.addEventListener('submit', handleSubmit);
        checkboxIsPaginationEnabled.addEventListener('change', handlePaginationCheckboxChange);
        document.addEventListener('DOMContentLoaded', InitializeAsync);

        // Register cleanup for these listeners.
        cleanupFunctions.push(() => {
            form.removeEventListener('submit', handleSubmit);
            checkboxIsPaginationEnabled.removeEventListener('change', handlePaginationCheckboxChange);
            document.removeEventListener('DOMContentLoaded', InitializeAsync);
        });

        async function InitializeAsync() {
            if (isInitialized)
                return;
            isInitialized = true;
            await loadUserSettingsAsync();
        }

        // Store all cleanups for this view on window object using the scriptId.
        window.viewCleanups = window.viewCleanups || {};
        window.viewCleanups['@scriptId'] = () => {
            cleanupFunctions.forEach(cleanup => cleanup());
            console.log(`Unloaded @scriptId`);
        };
        console.log(`Loaded @scriptId`);
    </script>
}
