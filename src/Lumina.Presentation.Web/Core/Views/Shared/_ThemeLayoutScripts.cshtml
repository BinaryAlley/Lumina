@using Lumina.Presentation.Web.Common.DTO.Configuration
@using Lumina.Presentation.Web.Common.Routes
@using Lumina.Presentation.Web.Common.Services
@using Microsoft.Extensions.Localization
@using Microsoft.Extensions.Options

@inject IStringLocalizerFactory _stringLocalizerFactory
@inject IOptions<ServerConfigurationDto> _serverConfigurationModel
@inject IUrlService _urlService

@{
    IStringLocalizer localizer = _stringLocalizerFactory.Create("Lumina.Presentation.Web.Views.Shared._Layout", "Lumina.Presentation.Web");
}

<script>
    var globalConfiguration = {
        serverBasePath: '@(_serverConfigurationModel.Value.BaseAddress):@(_serverConfigurationModel.Value.Port)',
        apiBasePath: '@(_serverConfigurationModel.Value.BaseAddress):@(_serverConfigurationModel.Value.Port)/api/v@(_serverConfigurationModel.Value.ApiVersion)',
    };
    var jsLocalizedMessages = {
        navigationFailed: '@localizer["NavigationFailed"]',
    };
    var jsLocalizedDialogs = {
        ok: '@localizer["Ok"]',
        cancel: '@localizer["Cancel"]',
        yes: '@localizer["Yes"]',
        no: '@localizer["No"]',
        retry: '@localizer["Retry"]',
        abort: '@localizer["Abort"]',
        ignore: '@localizer["Ignore"]',
        confirmation: '@localizer["Confirmation"]',
        warning: '@localizer["Warning"]',
        error: '@localizer["Error"]',
        information: '@localizer["Information"]'
    };
    // The endpoints the audio player reads the stored playback preferences of the user from, writes the volume and mute
    // state it changes back to, and fetches the playback manifest of a track from, together with the stream route
    // template the manifest path must match. The routes are the culture aware web routes, so the player never hardcodes
    // a path, and it never reaches the API server directly.
    var audioPlayerConfiguration = {
        getUserSettingsUrl: '@_urlService.GetRelativeUrl(WebRoutes.Settings.GET_USER_SETTINGS)',
        getPlaybackStateUrl: '@_urlService.GetRelativeUrl(WebRoutes.Settings.GET_PLAYBACK_STATE)',
        updatePlaybackStateUrl: '@_urlService.GetRelativeUrl(WebRoutes.Settings.UPDATE_PLAYBACK_STATE)',
        getPlaybackManifestUrl: '@_urlService.GetRelativeUrl(WebRoutes.Music.GET_PLAYBACK_MANIFEST)',
        streamTrackRouteTemplate: '@_urlService.GetRelativeUrl(WebRoutes.Music.STREAM_TRACK)',
        streamTrackSegmentRouteTemplate: '@_urlService.GetRelativeUrl(WebRoutes.Music.STREAM_TRACK_SEGMENT)',
        // The endpoints the queue of the player is built from: the releases of an artist, the tracks of a release, and the
        // artists of a library, which are also the endpoints the autoplay continuation and the library shuffle use. The
        // queue script documents which context uses which endpoint, and appends the library and pagination query parameters.
        getArtistsUrl: '@_urlService.GetRelativeUrl(WebRoutes.Music.GET_ARTISTS)',
        getArtistAlbumsUrl: '@_urlService.GetRelativeUrl(WebRoutes.Music.GET_ARTIST_ALBUMS)',
        getAlbumTracksUrl: '@_urlService.GetRelativeUrl(WebRoutes.Music.GET_ALBUM_TRACKS)',
        // The full album details, used by the expanded player for the release labels and the artwork carousel of the
        // current track's album. The route carries the artist and album Ids, and the library Id is a query parameter.
        getAlbumUrl: '@_urlService.GetRelativeUrl(WebRoutes.Music.GET_ALBUM)',
        // The endpoint that draws a uniformly random batch of tracks of a library, artist or album. The server samples the
        // database, so a shuffle of a large library never has to enumerate its albums and tracks in the browser.
        shuffleTracksUrl: '@_urlService.GetRelativeUrl(WebRoutes.Music.SHUFFLE_TRACKS)',
        // The playlists of the user, and the route that appends the current queue to one of them. The queue action in the
        // expanded bar uses the first to fill its select and the second to send the ordered track Ids in one request.
        getPlaylistsUrl: '@_urlService.GetRelativeUrl(WebRoutes.Playlists.GET_PLAYLISTS)',
        addPlaylistEntriesRouteTemplate: '@_urlService.GetRelativeUrl(WebRoutes.Playlists.ADD_PLAYLIST_ENTRIES, new { playlistId = default(Guid) })',
        strings: {
            play: '@localizer["AudioPlayerPlay"]',
            pause: '@localizer["AudioPlayerPause"]',
            mute: '@localizer["AudioPlayerMute"]',
            unmute: '@localizer["AudioPlayerUnmute"]',
            volume: '@localizer["AudioPlayerVolume"]',
            seek: '@localizer["AudioPlayerSeek"]',
            buffering: '@localizer["AudioPlayerBuffering"]',
            previous: '@localizer["AudioPlayerPrevious"]',
            next: '@localizer["AudioPlayerNext"]',
            repeat: '@localizer["AudioPlayerRepeat"]',
            repeatOff: '@localizer["AudioPlayerRepeatOff"]',
            repeatAll: '@localizer["AudioPlayerRepeatAll"]',
            repeatOne: '@localizer["AudioPlayerRepeatOne"]',
            queue: '@localizer["AudioPlayerQueue"]',
            albumArtwork: '@localizer["AudioPlayerAlbumArtwork"]',
            addQueueToPlaylist: '@localizer["AudioPlayerAddQueueToPlaylist"]',
            selectPlaylist: '@localizer["AudioPlayerSelectPlaylist"]',
            playlistQueueAdded: '@localizer["AudioPlayerPlaylistQueueAdded"]',
            playlistQueueAddFailed: '@localizer["AudioPlayerPlaylistQueueAddFailed"]',
            noPlaylists: '@localizer["AudioPlayerNoPlaylists"]',
            add: '@localizer["AudioPlayerAdd"]',
            addToPlaylist: '@localizer["PlaylistAddToPlaylist"]'
        }
    };
    // The endpoints and dialog labels of the add-to-playlist actions that the music library, artist and album cards share. The route
    // that returns the track Ids of a scope lets a whole library, artist or album be added in one batch request, and the batch
    // route is the same one the player uses for its queue. The routes are culture aware web routes, so the pages never hardcode
    // a path, and the dialog labels come from the global resources.
    var playlistConfiguration = {
        getPlaylistsUrl: '@_urlService.GetRelativeUrl(WebRoutes.Playlists.GET_PLAYLISTS)',
        addPlaylistEntryUrl: '@_urlService.GetRelativeUrl(WebRoutes.Playlists.ADD_PLAYLIST_ENTRY, new { playlistId = default(Guid) })',
        addScopeEntriesUrl: '@_urlService.GetRelativeUrl(WebRoutes.Playlists.ADD_PLAYLIST_SCOPE_ENTRIES, new { playlistId = default(Guid) })',
        createPlaylistUrl: '@_urlService.GetRelativeUrl(WebRoutes.Playlists.ADD)',
        strings: {
            selectPlaylist: '@localizer["AudioPlayerSelectPlaylist"]',
            noPlaylists: '@localizer["AudioPlayerNoPlaylists"]',
            createPlaylist: '@localizer["PlaylistCreate"]',
            tracksAdded: '@localizer["PlaylistTracksAdded"]',
            tracksAddFailed: '@localizer["PlaylistTracksAddFailed"]',
            noTracksToAdd: '@localizer["PlaylistNoTracksToAdd"]',
            add: '@localizer["AudioPlayerAdd"]'
        }
    };
</script>
@if (User?.Identity?.IsAuthenticated == true)
{
    <!-- The audio player writes the volume and mute state it changes to the playback state endpoint, which validates an
         anti-forgery token. The player is rendered only for an authenticated visitor, so the token is rendered here too,
         once, with the global configuration, whatever the active theme is. -->
    @Html.AntiForgeryToken()
}
