@using Lumina.Presentation.Web.Common.DTO.Themes
@using Lumina.Presentation.Web.Common.Primitives
@using Lumina.Presentation.Web.Core.Themes
@using Microsoft.AspNetCore.Html
@using System.IO
@using System.Text.Encodings.Web

@inject ThemeLayoutRenderer _themeLayoutRenderer

@{
    string bodyHtml;
    using (StringWriter bodyWriter = new())
    {
        IHtmlContent bodyContent = RenderBody();
        bodyContent.WriteTo(bodyWriter, HtmlEncoder.Default);
        bodyHtml = bodyWriter.ToString();
    }

    string scriptsHtml;
    using (StringWriter scriptsWriter = new())
    {
        TextWriter originalWriter = ViewContext.Writer;
        ViewContext.Writer = scriptsWriter;
        await RenderSectionAsync("Scripts", required: false);
        ViewContext.Writer = originalWriter;
        scriptsHtml = scriptsWriter.ToString();
    }

    string title = ViewData["Title"]?.ToString() ?? string.Empty;
    Result<string> themedResult = await _themeLayoutRenderer.RenderAsync(new ThemeLayoutPageDto(title, bodyHtml, scriptsHtml), cancellationToken: ViewContext.HttpContext.RequestAborted);
}

@if (themedResult.IsSuccess)
{
    @Html.Raw(themedResult.Value)
}
else
{
    <!DOCTYPE html>
    <html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>@ViewData["Title"] - Lumina</title>
        @await Html.PartialAsync("_ThemeLayoutHead")
    </head>
    <body>
        <div id="page">
            <header>
                @await Html.PartialAsync("_NavMenu")
            </header>
            <main role="main" style="@(User?.Identity?.IsAuthenticated == false ? "bottom: 0px;" : string.Empty)">
                <article class="h-100">
                    @Html.Raw(bodyHtml)
                    <div id="modal-background-article"></div>
                    <div class="dialog-container"></div>
                </article>
            </main>
            @if (User?.Identity?.IsAuthenticated == true)
            {
                @await Html.PartialAsync("_AudioPlayer")
            }
        </div>
        <div id="modal-background-menu"></div>
        @await Html.PartialAsync("_ThemeLayoutScripts")
        <div data-section="scripts">
            @Html.Raw(scriptsHtml)
        </div>
    </body>
    </html>
}
