@using Microsoft.AspNetCore.Mvc.Localization

@inject IViewLocalizer _localizer

@*
    This view is the application fallback of the file system browser component, rendered only when the theme template of the component cannot be loaded.
    It is intentionally plain and unstyled: on a healthy site the component comes from the theme's shared/file-system-browser template.
    It keeps the DOM contract the client script binds to, without any images, so that the active theme cannot leak into the fallback.
*@

<div id="file-system-browser-dialog" class="container-background above-modal">
    <div id="file-system-browser-content">
        <div id="file-system-browser-header">
            <div id="file-system-browser-header-navigation-container">
                <!--File System Navigator-->
                <div id="navigator-view-mode-container">
                    <button id="navigator-list-view" type="button">@_localizer["ListView"]</button>
                    <button id="navigator-details-view" type="button">@_localizer["DetailsView"]</button>
                    <button id="navigator-small-icons-view" type="button">@_localizer["SmallIconsView"]</button>
                    <button id="navigator-medium-icons-view" type="button">@_localizer["MediumIconsView"]</button>
                    <button id="navigator-large-icons-view" type="button">@_localizer["LargeIconsView"]</button>
                    <button id="navigator-extra-large-icons-view" type="button">@_localizer["ExtraLargeIconsView"]</button>
                </div>
                <!--Navigation-->
                <div id="navigator-navigation-controls-container">
                    <div id="navigator-history">
                        <button id="navigator-navigate-back" type="button">@_localizer["Back"]</button>
                        <button id="navigator-navigate-forward" type="button">@_localizer["Forward"]</button>
                        <button id="navigator-navigate-up" type="button">@_localizer["UpOneLevel"]</button>
                    </div>
                    <button id="navigator-toggle-tree-view-button" type="button">@_localizer["ToggleTreeView"]</button>
                    <button id="navigator-toggle-thumbnails-button" type="button">@_localizer["ToggleThumbanils"]</button>
                    <button id="navigator-toggle-hidden-button" type="button">@_localizer["ToggleHiddenItems"]</button>
                    <button id="navigator-toggle-selection-button" type="button">@_localizer["ToggleSelectionMode"]</button>
                </div>
                <!--Navigator-->
                <div id="navigator-address-bar-container">
                    <div id="navigator-address-bar-group">
                        <input type="text" class="navigator-address-bar-input" Name="navigator-address-bar-input" autocomplete="on" id="navigator-address-bar-input" />
                        <div id="navigator-address-bar">
                            <ul id="navigator-path-segments">
                            </ul>
                        </div>
                    </div>
                    <button id="navigator-edit-path-button" type="button">@_localizer["EditPath"]</button>
                    <button id="navigator-navigate-button" type="button">@_localizer["Navigate"]</button>
                    <button class="file-system-browser-content-new-directory" type="button">@_localizer["NewDirectory"]</button>
                    <button class="file-system-browser-content-favorite-directory" type="button">@_localizer["FavoriteDirectory"]</button>
                </div>
                <!--End File System Navigator-->
            </div>
        </div>
        <div id="file-system-browser-file-system-container">
            <!--File System Tree View-->
            <div id="file-system-browser-file-system-treeview-container">
                <div id="file-system-browser-file-system-treeview">
                    <div id="file-system-browser-treeview" class="treeview">
                    </div>
                </div>
            </div>
            <!--End File System Tree View-->
            <div id="file-system-browser-file-system-directories-container">
                <div id="file-system-browser-file-system-directories">
                    <div id="file-system-browser-file-system-explorer-container" class="scroll-horizontal">
                        <div id="file-system-browser-file-system-explorer-details-header" style="height: 0px;">
                            <span>@_localizer["Name"]</span>
                        </div>
                        <div id="file-system-browser-file-system-explorer">
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div id="file-system-browser-actions-container">
            <div id="file-system-browser-actions-path-container">
                <label>@_localizer["Directory"]</label>
                <input type="text" id="file-system-browser-selected-element" Name="file-system-browser-selected-element" readonly autocomplete="on" />
            </div>
            <div id="file-system-browser-actions">
                <button id="file-system-browser-cancel-button" type="button">@_localizer["Cancel"]</button>
                <button id="file-system-browser-confirm-button" type="button" disabled>@_localizer["Open"]</button>
            </div>
        </div>
    </div>
</div>
<div id="visible-selection-rectangle"></div>
<div id="selection-rectangle"></div>
<script defer src="~/js/theme-client-template-engine.js" data-component-script="file-system-browser"></script>
<script defer src="~/js/file-system-browser-dialog.js" data-component-script="file-system-browser"></script>
<script defer data-component-init="file-system-browser">
    // this outer function executes immediately and creates a scope for the variables
    (function() {
        // this inner function contains the actual initialization code that needs to run
        async function checkAndInit() {
            if (typeof initFileSystemBrowser === 'undefined' || typeof callApiGetAsync === 'undefined') {
                setTimeout(checkAndInit, 10);
                return;
            }
            await initFileSystemBrowser({
                serverBasePath: '@Model.ServerBasePath',
                clientBasePath: '@Model.ClientBasePath',
                path: '@Model.Path.Replace(@"\", @"\\")',
                viewMode: '@Model.ViewMode',
                iconSize: '@Model.IconSize'
            });
        }
        checkAndInit().catch(error => console.error('Failed to initialize file system browser:', error));
    })();
</script>
