@*
    FALLBACK NOT FOUND PAGE - READ BEFORE EDITING

    This view is the application fallback of the not found page, rendered only when the theme template of the page cannot be
    loaded. On a healthy site the page comes from the theme's shared/not-found template. It keeps the DOM contract the theme
    template mirrors, so that the page still shows the localized message even without the theme.

    To restyle the page, edit the theme files. This fallback is intentionally plain, so that a broken theme is obvious to the
    user while the page still functions.

/not-found/
*@

@using Microsoft.AspNetCore.Mvc.Localization

@inject IViewLocalizer _localizer

<div style="display: grid; grid-template-rows: auto 1fr;">
    <!--container with two rows, one fixed, one filling remaining space-->
    <div style="min-height: 1rem;"></div><!--the first row is a dummy row for "margin", because setting a margin on the next row would offset the parent's position-->
    <div class="enlightenment-panel shadow-effect p-2 mx-auto panel w-55 mb-10" style="min-width: 320px;">
        <div class="shine-effect"></div>
        <div class="text-center w-100">
            <p class="invalid-feedback f-18 w-100"><b>@_localizer["PageNotFound"]</b></p>
            <p class="invalid-feedback f-18 w-100"><b>@_localizer["ThereIsNoPage"]</b></p>
        </div>
    </div>
</div>
