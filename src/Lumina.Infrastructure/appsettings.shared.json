{
    "MediaSettings": {
        "RootDirectory": "media",
        "LibrariesDirectory":  "libraries",
        "BooksDirectory": "books",
        "MusicDirectory": "music"
    },
    "PluginsSettings": {
        "Directory": "plugins"
    },
    "ThemeEngine": {
        "StoragePath": "themes",
        "BundledThemesPath": "themes/bundled",
        "DefaultThemeId": "lumina-default",
        "MaxArchiveBytes": 8388608,
        "MaxExpandedBytes": 25165824,
        "MaxSingleFileBytes": 6291456,
        "MaxEntries": 250
    },
    "TranscodingSettings": {
        "FfmpegPath": "ffmpeg",
        "MaxConcurrentJobs": 2,
        "MaxCacheBytes": 2147483648,
        "JobTimeoutSeconds": 900,
        "EvictionGraceSeconds": 120,
        "CacheDirectory": null
    },
    "ConnectionStrings": {
        "DefaultConnection": "Server=<host>;Database=<database>;User Id=<user>;Password=<password>;"
    },
    "Serilog": {
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
            }
        },
        "Enrich": [
            "FromLogContext",
            "WithMachineName",
            "WithThreadId"
        ]
    }
}
